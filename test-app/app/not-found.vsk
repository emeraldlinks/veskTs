import { Link } from '@vesk/runtime/router';

interface NotFoundProps {
	url: string
}

component NotFound404(props: NotFoundProps) {
	<main class="max-w-3xl mx-auto my-16 px-4 text-center">
		<h1 class="text-6xl font-bold text-gray-200 mb-4">404</h1>
		<h2 class="text-2xl font-semibold mb-2">Page Not Found</h2>
		<p class="text-gray-500 mb-8">Sorry, we couldn't find <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono">{props.url}</code></p>
		<Link href="/" class="text-blue-600 no-underline hover:underline font-medium">← Go home</Link>
	</main>
}
