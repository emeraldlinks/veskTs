interface Post {
	id: number
	title: string
	slug: string
	excerpt: string
	author: string
	tags: string[]
	date: string
}

async component AsyncPage() {
	<Head>
		<title>Async — async components</title>
	</Head>

	const posts = await useFetch<Post[]>('/api/posts')

	<h1 class="text-3xl font-bold mb-4">Async Demo</h1>
	<p class="text-gray-500 mb-6">
		This page is an <code>async component</code>. <code>await useFetch('/api/posts')</code> suspends
		during SSR, the multi-pass renderer awaits it, and the page hydrates with the serialized
		data — no client-side refetch.
	</p>

	<h2 class="text-xl font-semibold mt-6 mb-2">Posts fetched during SSR</h2>
	for (const post of posts) {
		<div class="bg-white rounded-lg p-4 mb-3 shadow-sm border border-gray-100">
			<h3 class="font-semibold">{post.title}</h3>
			<p class="text-gray-500 text-sm">{post.excerpt}</p>
		</div>
	}
}
