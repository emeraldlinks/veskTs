import { NavLink } from '@vesk/runtime';

interface NavItem {
	label: string
	href: string
}

interface LayoutProps {
	children: unknown
}

const navItems: NavItem[] = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Posts', href: '/posts' },
	{ label: 'Statements', href: '/statements' },
	{ label: 'Async', href: '/async' },
	{ label: 'Map', href: '/map' },
	{ label: 'Empty', href: '/empty' },
	{ label: 'Md', href: '/md' },
	{ label: 'Broken', href: '/broken' },
]

component Layout(props: LayoutProps) {
	<Head>
	
	</Head>
	<nav class="flex nav gap-6 px-8 py-4 border-b border-gray-200 bg-white">
		for (const item of navItems) {
			<NavLink href={item.href} class="text-gray-500 hover:text-black font-medium no-underline">{item.label}</NavLink>
		}
	</nav>
	<style> 
	.nav {
		margin-left: 20px;
		display: flex;
		gap: 10px;
	}
	</style>
	<main class="max-w-3xl mx-auto my-8 px-4">{props.children}</main>
	<footer class="text-center py-8 text-gray-400 text-sm">
		<p>Powered by Vesk</p>
	</footer>
}
