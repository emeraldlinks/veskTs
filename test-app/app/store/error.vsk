component StoreError(props) {
	<div class="max-w-2xl mx-auto my-12 p-8 bg-amber-50 border-l-4 border-amber-500 rounded-r-lg">
		<h1 class="text-2xl font-bold text-amber-800 mb-2">Store Error Boundary</h1>
		<p class="text-amber-700 mb-4">{props.error}</p>
		<pre class="bg-amber-100 p-3 rounded text-xs font-mono overflow-x-auto">{props.stack}</pre>
		<p class="text-sm text-amber-600">{props.url}</p>
	</div>
}
