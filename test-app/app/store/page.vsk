import { Link } from '@vesk/runtime/router';

interface StoreLink {
	label: string
	href: string
	note: string
}

const storeLinks: StoreLink[] = [
	{ label: '/store/widget', href: '/store/widget', note: 'renders normally' },
	{ label: '/store/missing', href: '/store/missing', note: 'throws NotFoundError → store not-found' },
	{ label: '/store/boom', href: '/store/boom', note: 'throws Error → store error boundary' },
]

component Store {
	<h1 class="text-3xl font-bold mb-4">Store</h1>
	<p class="text-gray-600 mb-6">Route-level error and not-found boundaries live under /store.</p>
	<ul class="space-y-3">
		for (const link of storeLinks) {
			<li><Link href={link.href} class="text-blue-600 no-underline hover:underline">{link.label} — {link.note}</Link></li>
		}
	</ul>
}
