import {track} from "@vesk/runtime";

interface CountProps {
	count: number
}

interface ThrowProps {
	fail: boolean
	count: number
	msg: string
}


component Home (){
	<Head>
		 <title> VeskTS test app </title>
		</Head>
  const &[count] = track<number>(10)
	<div class=""> </div>
	
  
	
	
	<h1 class="text-4xl font-bold mb-2">Welcome to Vesk</h1>
	<p class="text-gray-500 mb-4">
		A compiler-first reactive UI framework for the post-VDOM web.
	</p>
	<p>{count} </p>
	if (2 > 3){
		<p> 2 is higher</p>
	} else{
		<p> Hurray 3 people won</p>
	}
	<button onClick={()=> count++}> + </button>
	<div class="bg-white gg rounded-xl p-6 shadow-sm border border-gray-100">
		<h2 class="text-xl  font-semibold mb-2">Getting Started</h2>
		<p>Edit <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono">app/page.vsk</code> to change this page.</p>
	
	<style>
		
		.gg {
		color: red;
		background: 3;
		border: 4px;
		
	} 
</style>

<Appx />
<Appxx count={count} />


	</div>
}




component Throws(props: ThrowProps) {
	if (props.fail) throw new Error(props.msg);
	return <p>OK</p>
}


export component Appx {
	try {
		<Throws fail={true} count={0} msg="Boom!" />
	} catch(e) {
		<p class="error">Error: {(e as Error).message}</p>
	}
}

component Throw(props: ThrowProps) client {


	if (props.count < 15) throw new Error(props.msg);
		return <p>OK {props.count} </p>
}




export component Appxx(props: CountProps)  {
	<p> Count: {props.count} </p>
	try {
		<Throw count={props.count} fail={true} msg={`Insufficient! ${props.count} `}/>
	} catch(e) {
		<p class="error">Error: {(e as Error).message}</p>
	}
}
