{
  "name": "vesk",
  "private": false,
  "type": "module",
  "description": "Vesk — A Compiler-First Framework for the Post-VDOM Web",
  "author": "emeraldlinks",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/adapter",
    "packages/adapters/vite",
    "packages/cli",
    "packages/compiler",
    "packages/create-vesk",
    "packages/plugin-tailwind",
    "packages/runtime",
    "packages/lsp",
    "packages/prettier-plugin"
  ],
  "scripts": {
    "build": "npx tsx packages/cli/build.ts",
    "typecheck": "tsc --noEmit -p packages/compiler/tsconfig.json && tsc --noEmit -p packages/runtime/tsconfig.json && tsc --noEmit -p packages/adapter/tsconfig.json",
    "test:dev": "npx tsx tests/dev-test.mjs",
    "test:prod": "npx tsx tests/prod-test.mjs",
    "test:unit": "node scripts/test.js",
    "test": "npm run test:unit && npm run test:dev",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "build:vsix": "node scripts/build-lsp.js && cd extension/vsk-vscode && npx tsc && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/wasm-node": "^4.62.2",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "tailwindcss": "^4.3.3",
    "lightningcss": "^1.32.0"
  }
}
