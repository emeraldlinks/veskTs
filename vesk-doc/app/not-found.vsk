import { Link } from '@vesk/runtime/router';

component NotFound404(props) {
	<main class="mx-auto max-w-3xl px-5 py-20 sm:px-8 text-center">
		<p class="eyebrow mb-4 justify-center flex">404 · not found</p>
		<h1 class="font-display text-6xl font-bold tracking-tight text-foreground/20">404</h1>
		<h2 class="mt-4 font-display text-2xl font-semibold tracking-tight">Page Not Found</h2>
		<p class="mt-3 font-mono text-[13px] leading-relaxed text-muted-foreground">Sorry, we couldn't find <code class="bg-surface border border-border px-1.5 py-0.5 text-[12px] font-mono text-foreground">{props.url}</code></p>
		<Link href="/" class="btn-solid mt-8 px-6 py-3 text-sm inline-grid no-underline">← Go home</Link>
	</main>
}
