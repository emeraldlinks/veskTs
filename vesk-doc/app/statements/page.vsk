component Statements {
	<Head>
		<title>Statements — every JS construct</title>
	</Head>
	const items = ['alpha', 'beta', 'gamma']
	const obj = { name: 'Vesk', year: 2026, tags: ['fast', 'reactive'] }
	const score = 7
	let n = 0

	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<p class="eyebrow mb-4">demo · statement mode</p>
		<h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">JS Statement Demo</h1>
		<p class="mt-3 font-mono text-[13px] text-muted-foreground">Every JS construct supported in .vsk statement mode.</p>

		<h2 class="font-display text-lg font-semibold tracking-tight mt-10 mb-3 border-t border-border pt-6">if / else</h2>
		if (score > 5) {
			<p class="font-mono text-[13px] text-accent">Score {score} is above the threshold</p>
		} else {
			<p class="font-mono text-[13px] text-destructive">Score {score} is low</p>
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">ternary</h2>
		<p class="font-mono text-[13px] text-muted-foreground">{score % 2 === 0 ? 'even' : 'odd'}</p>

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">switch</h2>
		switch (score) {
			case 1:
				<p class="font-mono text-[13px] text-muted-foreground">One</p>
				break
			case 7:
				<p class="font-mono text-[13px] text-foreground">Seven</p>
				break
			default:
				<p class="font-mono text-[13px] text-muted-foreground">Something else</p>
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">for loop</h2>
		for (let i = 0; i < 3; i++) {
			<span class="mr-2 font-mono text-[12px] text-muted-foreground">i={i}</span>
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">for-of (array values)</h2>
		for (const item of items) {
			<span class="mr-2 font-mono text-[12px] text-muted-foreground">{item}</span>
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">for-in (object keys)</h2>
		for (const key in obj) {
			<span class="mr-2 font-mono text-[12px] text-muted-foreground">{key}:{obj[key]}</span>
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">while</h2>
		while (n < 3) {
			<span class="mr-2 font-mono text-[12px] text-muted-foreground">{n}</span>
			n = n + 1
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">try / catch / throw</h2>
		try {
			throw new Error('Boom!')
		} catch(e) {
			<p class="font-mono text-[13px] text-destructive">Caught: {(e as Error).message}</p>
		}

		<h2 class="font-display text-lg font-semibold tracking-tight mt-8 mb-3">runtime statements</h2>
		const total = items.length * 2
		<p class="font-mono text-[13px] text-muted-foreground">items.length * 2 = {total}</p>
	</div>
}
