import { Link } from '@vesk/runtime/router'

component ShowcaseIndex {
	<Head>
		<title>Showcase — Built with Vesk | Vesk</title>
		<meta name="description" content="Real apps compiled with Vesk: Aurora Console (web), Fieldbook (Android native), Signal Docs (web+Kotlin). Metrics, stacks, and how they compare to Next/React Native." />
	</Head>
	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<p class="eyebrow mb-5 flex items-center gap-2"><span class="text-accent">·</span><span>product · showcase</span></p>
		<h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Built with Vesk.</h1>
		<p class="mt-5 max-w-[60ch] font-mono text-[13px] leading-relaxed text-muted-foreground">Not demos — shipped products. Same component model, two compilers. Proof that compiler-first scales beyond todo apps.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Link href="/comparison" class="btn-solid px-5 py-3 text-sm no-underline">Compare stacks →</Link>
			<Link href="/examples" class="btn-outline px-5 py-3 text-sm no-underline">See examples</Link>
		</div>

		<div class="mt-14 grid gap-4 lg:grid-cols-3">
			for (const p of [
				{ slug: "aurora", name: "Aurora Console", platform: "Web", href: "/showcase/aurora", desc: "Ops dashboard for a deployment platform. Streams logs, parallel revalidation, offline-aware routing.", metric: "48 kB shipped", stack: "Vesk · useFetch · Tailwind", highlight: "1,200-row live table — O(1) per-cell, 0 jank" },
				{ slug: "fieldbook", name: "Fieldbook", platform: "Android Native", href: "/showcase/fieldbook", desc: "Offline-first field notes with camera, GPS, and sync. One .vsk codebase, Kotlin on device.", metric: "240 ms cold start", stack: "Vesk Native · Kotlin · Compose", highlight: "Works offline by default — same offline.vsk as web" },
				{ slug: "signal-docs", name: "Signal Docs", platform: "Web + Native", href: "/showcase/signal-docs", desc: "Docs site and native help share the same library. Design tokens and Markdown pipeline are one.", metric: "2 targets · 1 model", stack: "One codebase", highlight: "No drift — web + help ship from same commit" },
			]) {
				<Link href={p.href} class="panel-strong group flex h-full flex-col justify-between p-6 no-underline hover:border-border-strong">
					<div>
						<div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground"><span>{p.platform}</span><span class="text-accent">{p.metric}</span></div>
						<h2 class="mt-4 font-display text-xl font-semibold tracking-tight group-hover:text-accent transition-colors">{p.name}</h2>
						<p class="mt-2 font-mono text-[12px] leading-relaxed text-muted-foreground">{p.desc}</p>
						<p class="mt-3 inline-flex items-center gap-1.5 bg-surface px-2 py-1 font-mono text-[11px]">{p.stack}</p>
						<p class="mt-3 font-mono text-[11px] font-medium text-foreground">→ {p.highlight}</p>
					</div>
					<div class="mt-8 border-t border-border pt-3 font-mono text-[11px] text-muted-foreground group-hover:text-foreground">View case study →</div>
				</Link>
			}
		</div>

		<div class="panel mt-10 overflow-hidden">
			<div class="border-b border-border px-4 py-2"><span class="eyebrow">metrics vs incumbent — same UI, same data</span></div>
			<div class="overflow-x-auto">
				<table class="w-full font-mono text-[12px]">
					<thead class="bg-surface/60 text-[11px] uppercase tracking-[0.14em] text-muted-foreground"><tr><th class="px-4 py-3 text-left font-medium">Metric (median)</th><th class="px-4 py-3 text-left font-medium">Vesk</th><th class="px-4 py-3 text-left font-medium">Next.js 15 + React</th><th class="px-4 py-3 text-left font-medium">SvelteKit</th></tr></thead>
					<tbody class="divide-y divide-border">
						<tr><td class="px-4 py-3">Home — JS shipped (gzip)</td><td class="px-4 py-3 text-accent">~22 kB (static) / 48 kB (dashboard)</td><td class="px-4 py-3">~95-140 kB</td><td class="px-4 py-3">~28-45 kB</td></tr>
						<tr><td class="px-4 py-3">Hydration cost (main thread)</td><td class="px-4 py-3">claim walk, static skipped</td><td class="px-4 py-3">hydrateRoot full replay</td><td class="px-4 py-3">hydration + runtime</td></tr>
						<tr><td class="px-4 py-3">List update 1k rows</td><td class="px-4 py-3">O(1) one text node</td><td class="px-4 py-3">O(n) VDOM + diff</td><td class="px-4 py-3">O(1) — Svelte fine</td></tr>
						<tr><td class="px-4 py-3">Build → .vesk (cold)</td><td class="px-4 py-3">~1.8 s (CI, 24 pages)</td><td class="px-4 py-3">~4-6 s</td><td class="px-4 py-3">~2-3 s</td></tr>
					</tbody>
				</table>
			</div>
			<p class="bg-surface/40 px-4 py-3 font-mono text-[11px] text-muted-foreground">* Numbers from showcase builds on same CI (4 vCPU, Node 20). Your app will differ — win is architectural, not a micro-benchmark.</p>
		</div>

		<div class="mt-10 grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
			for (const c of [
				{ k: "48 kB", l: "Aurora shipped", d: "Next equiv 182 kB on same UI" },
				{ k: "240 ms", l: "Fieldbook cold", d: "RN equiv 410 ms on same device" },
				{ k: "73%", l: "less JS (docs)", d: "Astro 0 → Vesk app primitives" },
				{ k: "1 model", l: "Signal Docs", d: "Web + native, zero drift" },
			]) {
				<div class="bg-surface p-5 text-center">
					<div class="font-display text-xl font-semibold">{c.k}</div>
					<div class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-accent">{c.l}</div>
					<div class="mt-1 font-mono text-[11px] text-muted-foreground">{c.d}</div>
				</div>
			}
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<Link href="/examples" class="btn-solid px-6 py-3 text-sm no-underline">Browse examples</Link>
			<Link href="/community/github" class="btn-outline px-6 py-3 text-sm no-underline">Star on GitHub →</Link>
		</div>
	</div>
}
