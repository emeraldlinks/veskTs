import { Link } from '@vesk/runtime/router'

component Aurora {
	<Head>
		<title>Aurora Console — 48 kB ops dashboard | Vesk Showcase</title>
		<meta name="description" content="Aurora Console case study: 1,200-row live table, streaming logs, per-cell reactivity vs Next.js VDOM, 48 kB shipped." />
	</Head>
	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<Link href="/showcase" class="font-mono text-[12px] text-muted-foreground hover:text-foreground no-underline">← showcase</Link>
		<p class="eyebrow mt-6 mb-5 flex items-center gap-2"><span class="text-accent">·</span><span>showcase · web</span></p>
		<h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Aurora Console</h1>
		<p class="mt-4 max-w-[60ch] font-mono text-[13px] leading-relaxed text-muted-foreground">Operations dashboard for a deployment platform. Streams logs, parallel deploys, and a 1,200-row live table that updates per-cell — not per-frame.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Link href="/examples" class="btn-solid px-5 py-3 text-sm no-underline">See code →</Link>
			<Link href="/comparison" class="btn-outline px-5 py-3 text-sm no-underline">vs Next.js</Link>
		</div>

		<div class="mt-10 grid gap-px bg-border sm:grid-cols-3">
			for (const s of [
				{ k: "48 kB", v: "JS shipped (gzip)", d: "Next equiv 182 kB" },
				{ k: "1,200 rows", v: "live updates", d: "O(1) per write" },
				{ k: "4 stages", v: "compiler proof", d: "no VDOM" },
			]) {
				<div class="bg-surface p-5 text-center">
					<div class="font-display text-lg font-semibold">{s.k}</div>
					<div class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-accent">{s.v}</div>
					<div class="mt-1 font-mono text-[11px] text-muted-foreground">{s.d}</div>
				</div>
			}
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">Stack</h3>
				<ul class="mt-3 list-disc pl-5 font-mono text-[12px] leading-relaxed text-muted-foreground space-y-1">
					<li>Vesk .vsk + track() — 1,200 cells, one effect per cell</li>
					<li>useFetch with into: streams log chunks into cells — no polling</li>
					<li>File routing <code class="bg-surface px-1 py-0.5">app/deploy/[id]/page.vsk</code> + manual admin subtree</li>
					<li>offline.vsk + network.vsk — deploy survives flaky WiFi</li>
				</ul>
			</div>
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">Why not Next?</h3>
				<ul class="mt-3 list-disc pl-5 font-mono text-[12px] leading-relaxed text-muted-foreground space-y-1">
					<li><strong class="text-foreground">Next:</strong> 1,200 rows → VDOM diff on every tick — jank, 80 kB React.</li>
					<li><strong class="text-foreground">Vesk:</strong> one <code class="bg-surface px-1 py-0.5">effect(()=&gt; cell.text = ...)</code> per row — main thread idle.</li>
					<li><strong class="text-foreground">Svelte:</strong> fine-grained too, but no SSR claim optimization for static chrome.</li>
					<li><strong class="text-foreground">Astro:</strong> great for static docs, not for live dashboards (needs islands per row).</li>
				</ul>
			</div>
		</div>

		<div class="panel mt-8 p-6">
			<h3 class="font-display text-sm font-semibold">Code that matters</h3>
			<pre class="mt-3 overflow-auto bg-background p-4 font-mono text-[11.5px] leading-relaxed"><code>{`component DeployRow(props: { id: string }) {
  const live = useFetch.json<Deploy>(\`/api/deploy/\${props.id}\`, { key: \`deploy-\${props.id}\` })
  if (live.loading) return <Skeleton />
  <tr class={live.data.status === 'live' ? 'text-accent' : ''}>
    <td>{live.data.status}</td>
    <td>{live.data.logs.at(-1)}</td>
  </tr>
}`}</code></pre>
			<p class="mt-3 font-mono text-[11px] text-muted-foreground">No map-re-render; each row re-renders when its own deploy key mutates. <code class="bg-surface px-1 py-0.5">mutate('deploy-42', next)</code> drives optimistic log appends.</p>
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<Link href="/showcase" class="btn-outline px-6 py-3 text-sm no-underline">← all showcases</Link>
			<Link href="/showcase/fieldbook" class="font-mono text-[11px] text-muted-foreground hover:text-foreground py-3 px-2 no-underline">Next: Fieldbook →</Link>
		</div>
	</div>
}
