import { Link } from '@vesk/runtime/router'

component SignalDocs {
	<Head>
		<title>Signal Docs — One library, web + native help | Vesk Showcase</title>
		<meta name="description" content="Signal Docs: same component library for web docs and Android help. Tailwind tokens → Compose theme, 2 targets 1 model, no drift." />
	</Head>
	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<Link href="/showcase" class="font-mono text-[12px] text-muted-foreground hover:text-foreground no-underline">← showcase</Link>
		<p class="eyebrow mt-6 mb-5 flex items-center gap-2"><span class="text-accent">·</span><span>showcase · web + native</span></p>
		<h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Signal Docs</h1>
		<p class="mt-4 max-w-[60ch] font-mono text-[13px] leading-relaxed text-muted-foreground">Documentation that ships as a website and as in-app help. Same Markdown pipeline, same component library, two emitters — drift is a build error, not a ticket.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Link href="/docs" class="btn-solid px-5 py-3 text-sm no-underline">Read docs →</Link>
			<Link href="/native" class="btn-outline px-5 py-3 text-sm no-underline">How we share</Link>
		</div>

		<div class="mt-10 grid gap-px bg-border sm:grid-cols-3">
			for (const s of [
				{ k: "2 targets", v: "1 model", d: "web + android help" },
				{ k: "0 drift", v: "same commit", d: "tokens → theme" },
				{ k: "1 Markdown", v: "pipeline", d: "unified MD → HTML/Compose" },
			]) {
				<div class="bg-surface p-5 text-center">
					<div class="font-display text-lg font-semibold">{s.k}</div>
					<div class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-accent">{s.v}</div>
					<div class="mt-1 font-mono text-[11px] text-muted-foreground">{s.d}</div>
				</div>
			}
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">The sharing that matters</h3>
				<ul class="mt-3 list-disc pl-5 font-mono text-[12px] leading-relaxed text-muted-foreground space-y-1">
					<li><strong class="text-foreground">Design:</strong> Tailwind tokens → Compose Material 3 theme (one source, not two).</li>
					<li><strong class="text-foreground">Content:</strong> Unified Markdown → HTML on web, Text composables on Android.</li>
					<li><strong class="text-foreground">Logic:</strong> Validation, routing groups, <code class="bg-surface px-1 py-0.5">useFetch</code> cache — shared.</li>
					<li><strong class="text-foreground">Icons:</strong> <code class="bg-surface px-1 py-0.5">lucide-vesk</code> maps to Compose icons.</li>
				</ul>
				<p class="mt-3 font-mono text-[11px] text-muted-foreground">Next/Svelte/Astro all stop at the web. Vesk's native emitter is the moat.</p>
			</div>
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">Vs status quo</h3>
				<ul class="mt-3 list-disc pl-5 font-mono text-[12px] leading-relaxed text-muted-foreground space-y-1">
					<li><strong class="text-foreground">Docs in Notion + native help in Figma:</strong> 2 systems, constant drift.</li>
					<li><strong class="text-foreground">Docs in Next + help in React Native:</strong> 2 codebases, 2 designs, 2 bugs.</li>
					<li><strong class="text-foreground">Vesk:</strong> 1 lib, 2 emitters — change once, ships twice, build fails if semantics diverge.</li>
				</ul>
			</div>
		</div>

		<div class="panel mt-8 p-6">
			<h3 class="font-display text-sm font-semibold">Library excerpt — same file, two outputs</h3>
			<pre class="mt-3 overflow-auto bg-background p-4 font-mono text-[11.5px] leading-relaxed"><code>{`component Callout(props: { type: "info"|"warn"; children: any }) {
  <div class={\`callout callout-\${props.type}\`}>
    <span class="eyebrow">{props.type}</span>
    {props.children}
  </div>
}
// web: <div class="callout"> → DOM
// native: <Callout> → Surface + Text (Compose)`}</code></pre>
			<p class="mt-3 font-mono text-[11px] text-muted-foreground">The compiler proves the callout is valid on both targets; if a prop can't be preserved, build fails — not a runtime surprise.</p>
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<Link href="/showcase" class="btn-outline px-6 py-3 text-sm no-underline">← all showcases</Link>
			<Link href="/showcase/aurora" class="font-mono text-[11px] text-muted-foreground hover:text-foreground py-3 px-2 no-underline">Next: Aurora →</Link>
		</div>
	</div>
}
