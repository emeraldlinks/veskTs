import { Link } from '@vesk/runtime/router'

component ApiDocs {
	<Head>
		<title>API — File-based API routes, typed handlers | Vesk</title>
		<meta name="description" content="Vesk API routes: app/api/**/route.ts, GET/POST/PUT/PATCH/DELETE, VeskRequest/VeskResponse, validation, middleware, ISR. Leaner than Next route handlers." />
	</Head>
	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<p class="eyebrow mb-5 flex items-center gap-2"><span class="text-accent">·</span><span>developers · api</span></p>
		<h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">API routes that feel like handlers, not framework.</h1>
		<p class="mt-5 max-w-[62ch] font-mono text-[13px] leading-relaxed text-muted-foreground">File <code class="bg-surface px-1 py-0.5">app/api/**/route.ts</code> → <code class="bg-surface px-1 py-0.5">GET/POST</code> at <code class="bg-surface px-1 py-0.5">/api/**</code>. Typed <code class="bg-surface px-1 py-0.5">VeskRequest/VeskResponse</code>, cookies, headers, validation — same middleware as pages.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Link href="/docs/api-routes" class="btn-solid px-5 py-3 text-sm no-underline">API docs →</Link>
			<Link href="/examples" class="btn-outline px-5 py-3 text-sm no-underline">See examples</Link>
		</div>

		<div class="mt-12 grid gap-6 lg:grid-cols-2">
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">What you write</h3>
				<pre class="mt-3 overflow-auto bg-background p-4 font-mono text-[11.5px] leading-relaxed"><code>{`import { VeskRequest, VeskResponse } from '@vesk/types'

export async function POST(req: VeskRequest) {
  const { name } = await req.json()
  if (!name) return VeskResponse.json({ error: "name required" }, { status: 400 })
  return VeskResponse.json({ ok: true, name })
}`}</code></pre>
				<p class="mt-3 font-mono text-[11px] text-muted-foreground">No config. <code class="bg-surface px-1 py-0.5">cookies()</code>, <code class="bg-surface px-1 py-0.5">headers()</code>, <code class="bg-surface px-1 py-0.5">locals()</code> — same as pages.</p>
			</div>
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">What you get</h3>
				<ul class="mt-3 list-disc pl-5 font-mono text-[12px] leading-relaxed text-muted-foreground space-y-1">
					<li>Dynamic <code class="bg-surface px-1 py-0.5">[slug]</code> + catch-all <code class="bg-surface px-1 py-0.5">[...rest]</code> — same as pages.</li>
					<li>Validation: <code class="bg-surface px-1 py-0.5">withValidation(req, schema)</code> → 422 + <code class="bg-surface px-1 py-0.5">issuesToFieldMap</code>.</li>
					<li>Middleware onion: auth once, reused for pages + API.</li>
					<li>ISR: <code class="bg-surface px-1 py-0.5">export const revalidate = 60</code>.</li>
				</ul>
			</div>
		</div>

		<div class="panel mt-8 overflow-hidden">
			<div class="border-b border-border px-4 py-2"><span class="eyebrow">vs other API stories</span></div>
			<div class="overflow-x-auto">
				<table class="w-full font-mono text-[12px]">
					<thead class="bg-surface/60 text-[11px] uppercase tracking-[0.14em] text-muted-foreground"><tr><th class="px-4 py-3 text-left font-medium">Pillar</th><th class="px-4 py-3 text-left font-medium">Vesk</th><th class="px-4 py-3 text-left font-medium">Next.js route handlers</th><th class="px-4 py-3 text-left font-medium">Express / Hono</th></tr></thead>
					<tbody class="divide-y divide-border">
						<tr><td class="px-4 py-3">Co-location</td><td class="px-4 py-3">Files under <code class="bg-surface px-1 py-0.5">app/api</code> + share middleware with pages</td><td class="px-4 py-3">Files under <code class="bg-surface px-1 py-0.5">app/api</code> (RSC split)</td><td class="px-4 py-3">Manual router file</td></tr>
						<tr><td class="px-4 py-3">Validation</td><td class="px-4 py-3">Built-in Zod + field map</td><td class="px-4 py-3">Manual (zod) per handler</td><td class="px-4 py-3">Middleware + lib</td></tr>
						<tr><td class="px-4 py-3">Auth share</td><td class="px-4 py-3">One <code class="bg-surface px-1 py-0.5">middleware.ts</code> for pages + API</td><td class="px-4 py-3">Duplicate per group</td><td class="px-4 py-3">App-level middleware</td></tr>
						<tr><td class="px-4 py-3">Typed errors</td><td class="px-4 py-3"><code class="bg-surface px-1 py-0.5">VeskResponse.json</code> + <code class="bg-surface px-1 py-0.5">HttpError</code></td><td class="px-4 py-3"><code class="bg-surface px-1 py-0.5">NextResponse</code> untyped</td><td class="px-4 py-3">Manual</td></tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<Link href="/docs/api-routes" class="btn-solid px-6 py-3 text-sm no-underline">Full API reference</Link>
			<Link href="/comparison" class="font-mono text-[11px] text-muted-foreground hover:text-foreground py-3 px-2 no-underline">Compare stacks →</Link>
		</div>
	</div>
}
