import { CodePanel } from './docs/CodePanel.vsk'

export component DocTabs(props: { tabs: { label: string; filename: string; code: string }[] }) {
	const &[index] = track(0)
	const &[current] = derived(() => props.tabs[index] ?? props.tabs[0])

	<div>
		<div class="flex flex-wrap gap-px bg-border">
			for (let i = 0; i < props.tabs.length; i++) {
				const t = props.tabs[i]
				<button
					type="button"
					onClick={() => index = i}
					aria-pressed={i === index}
					class={i === index ? "px-3 py-2 font-mono text-[11.5px] bg-foreground text-background" : "px-3 py-2 font-mono text-[11.5px] bg-surface text-muted-foreground hover:text-foreground"}
				>{t.label}</button>
			}
		</div>
		if (current) {
			<CodePanel filename={current.filename} code={current.code} />
		}
	</div>
}