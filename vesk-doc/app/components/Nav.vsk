import { Menu, X } from 'lucide-vesk'

const links = [
	{ label: "compiler", href: "#compiler" },
	{ label: "native", href: "#native" },
	{ label: "features", href: "#features" },
	{ label: "docs", href: "#docs" },
	{ label: "showcase", href: "#showcase" },
]

export component Nav {
	const &[open] = track(false)

	<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md">
		<div class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-3 sm:px-8">
			<a href="#top" class="flex items-center gap-2 no-underline">
				<span class="grid size-6 place-items-center bg-foreground font-display text-[11px] font-bold text-background">V</span>
				<span class="font-display text-sm font-semibold tracking-tight text-foreground">vesk</span>
				<span class="hidden font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground sm:inline">compiler-first</span>
			</a>
			<nav class="hidden items-center gap-6 font-mono text-[11px] text-muted-foreground md:flex">
				for (const l of links) {
					<a href={l.href} class="transition-colors hover:text-foreground no-underline text-muted-foreground">{l.label}</a>
				}
				<a href="#get-started" class="btn-solid px-3 py-1.5 text-[11px] no-underline">Get Started</a>
			</nav>
			<button
				type="button"
				aria-label={open ? "Close menu" : "Open menu"}
				onClick={() => open = !open}
				class="grid size-8 place-items-center border border-border md:hidden bg-transparent text-foreground"
			>
				if (open) {
					<X size={16} />
				} else {
					<Menu size={16} />
				}
			</button>
		</div>
		if (open) {
			<nav class="border-t border-border bg-background px-5 py-3 font-mono text-[12px] md:hidden">
				for (const l of links) {
					<a
						href={l.href}
						onClick={() => open = false}
						class="block border-b border-border/60 py-2.5 text-muted-foreground no-underline"
					>{l.label}</a>
				}
				<a
					href="#get-started"
					onClick={() => open = false}
					class="btn-solid mt-3 w-full px-3 py-2.5 text-[12px] no-underline"
				>Get Started</a>
			</nav>
		}
	</header>
}
