import { getDoc, getNeighbours, headingId } from '../../../src/content/docs'
import { Info, TriangleAlert } from 'lucide-vesk'
import { Link } from '@vesk/runtime/router'
import { NotFoundError } from '@vesk/runtime/router'
import { DocTabs } from '../../components/DocTabs.vsk'
import { DocsToc } from '../../components/docs/DocsToc.vsk'
import { CodePanel } from '../../components/docs/CodePanel.vsk'

component DocsPage(props: { params: { slug: string } }) {
	const doc = getDoc(props.params.slug)
	if (!doc) {
		throw new NotFoundError()
	}
	const neighbours = getNeighbours(doc.slug)
	const prev = neighbours.prev
	const next = neighbours.next
	const toc = doc.blocks.filter((b) => b.kind === "h2").map((b) => ({ id: headingId((b as any).text), text: (b as any).text }))

	<Head>
		<title>{doc.title} — Vesk Docs</title>
		<meta name="description" content={doc.description} />
	</Head>

	<div class="grid gap-10 px-5 py-12 sm:px-10 sm:py-14 xl:grid-cols-[minmax(0,1fr)_180px]">
		<article class="min-w-0">
			<p class="eyebrow mb-4 flex items-center gap-2">
				<Link href="/docs" class="hover:text-foreground no-underline text-muted-foreground">docs</Link>
				<span aria-hidden>/</span>
				<span>{doc.group}</span>
			</p>
			<h1 class="max-w-[26ch] font-display text-2xl font-semibold leading-[1.1] tracking-tight sm:text-3xl">{doc.title}</h1>
			<p class="mt-4 max-w-[64ch] font-mono text-[13px] leading-relaxed text-muted-foreground">{doc.description}</p>

			<div class="mt-10 space-y-6">
				for (const block of doc.blocks) {
					if (block.kind === "h2") {
						<h2 id={headingId(block.text)} class="scroll-mt-24 border-t border-border pt-8 font-display text-lg font-semibold tracking-tight text-foreground sm:text-xl">{block.text}</h2>
					} else if (block.kind === "p") {
						<p class="max-w-[70ch] font-mono text-[13px] leading-relaxed text-muted-foreground text-pretty">{block.text}</p>
					} else if (block.kind === "list") {
						<ul class="max-w-[70ch] space-y-2 list-none m-0 p-0">
							for (const item of block.items) {
								<li class="flex gap-3 font-mono text-[13px] leading-relaxed text-muted-foreground">
									<span class="mt-[7px] size-1 shrink-0 bg-accent"></span>
									<span>{item}</span>
								</li>
							}
						</ul>
					} else if (block.kind === "note") {
						<div class={block.tone === "warn" ? "flex max-w-[70ch] gap-3 border-l-2 border-accent bg-surface/50 px-4 py-3" : "flex max-w-[70ch] gap-3 border-l-2 border-border-strong bg-surface/50 px-4 py-3"}>
						{block.tone === "warn"
							? <TriangleAlert size={16} class="mt-0.5 shrink-0 text-accent" />
							: <Info size={16} class="mt-0.5 shrink-0 text-muted-foreground" />}
						<p class="font-mono text-[12.5px] leading-relaxed text-foreground/80">{block.text}</p>
					</div>
				} else if (block.kind === "code") {
					<CodePanel filename={block.filename} code={block.code} />
					} else if (block.kind === "tabs") {
						<DocTabs tabs={block.tabs} />
					} else if (block.kind === "table") {
						<div class="overflow-x-auto border border-border">
							<table class="w-full border-collapse font-mono text-[12px]">
								<thead>
									<tr class="border-b border-border bg-surface/60 text-left">
										for (const h of block.head) {
											<th class="px-3 py-2 font-medium uppercase tracking-[0.14em] text-[10px] text-muted-foreground">{h}</th>
										}
									</tr>
								</thead>
								<tbody>
									for (const row of block.rows) {
										<tr class="border-b border-border/60 last:border-b-0">
											for (let ci = 0; ci < row.length; ci++) {
												const cell = row[ci]
												<td class={ci === 0 ? "px-3 py-2 align-top text-foreground" : "px-3 py-2 align-top text-muted-foreground"}>{cell}</td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
			</div>

			<nav class="mt-14 grid gap-px border-t border-border bg-border sm:grid-cols-2">
				if (prev) {
					<Link href={"/docs/" + prev.slug} class="bg-background px-4 py-4 transition-colors hover:bg-surface/60 no-underline block">
						<span class="eyebrow">previous</span>
						<span class="mt-1 block font-display text-sm font-medium text-foreground">← {prev.title}</span>
					</Link>
				} else {
					<span class="bg-background"></span>
				}
				if (next) {
					<Link href={"/docs/" + next.slug} class="bg-background px-4 py-4 text-right transition-colors hover:bg-surface/60 no-underline block">
						<span class="eyebrow">next</span>
						<span class="mt-1 block font-display text-sm font-medium text-foreground">{next.title} →</span>
					</Link>
				} else {
					<span class="bg-background"></span>
				}
			</nav>
		</article>

		<DocsToc items={toc} />
	</div>
}