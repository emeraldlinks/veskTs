import { docGroups, docPages } from '../../src/content/docs'
import { Link } from '@vesk/runtime/router'

component DocsIndex {
	<Head>
		<title>Vesk Documentation — compiler-first framework reference</title>
		<meta name="description" content="Guides and reference for the Vesk compiler-first framework: quickstart, components, reactivity with track, routing, data fetching, hydration, native Kotlin output and deployment." />
	</Head>

	<div class="px-5 py-12 sm:px-10 sm:py-16">
		<p class="eyebrow mb-5">documentation</p>
		<h1 class="max-w-[24ch] font-display text-3xl font-semibold leading-[1.05] tracking-tight sm:text-4xl">Everything the compiler does, written down.</h1>
		<p class="mt-5 max-w-[58ch] font-mono text-[13px] leading-relaxed text-muted-foreground">
			Start with the quickstart, then read concepts before reference. Every diagnostic, target behaviour and configuration option has a page.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Link href="/docs/getting-started" class="btn-solid px-5 py-3 font-display text-sm no-underline">Quickstart</Link>
			<Link href="/docs/cli" class="btn-outline px-5 py-3 font-display text-sm no-underline">CLI reference</Link>
		</div>

		<div class="mt-14 space-y-10">
			for (const group of docGroups) {
				const pages = docPages.filter((p) => p.group === group)
				if (pages.length > 0) {
					<section>
						<p class="eyebrow mb-4 border-b border-border pb-2">{group}</p>
						<div class="grid gap-px bg-border sm:grid-cols-2">
							for (const p of pages) {
								<Link href={"/docs/" + p.slug} class="group bg-background p-5 transition-colors hover:bg-surface/60 no-underline block">
									<div class="flex items-center justify-between gap-3">
										<h2 class="font-display text-base font-semibold tracking-tight text-foreground">{p.title}</h2>
										<span class="font-mono text-[11px] text-muted-foreground transition-transform group-hover:translate-x-0.5">→</span>
									</div>
									<p class="mt-2 font-mono text-[12px] leading-relaxed text-muted-foreground">{p.description}</p>
								</Link>
							}
						</div>
					</section>
				}
			}
		</div>
	</div>
}