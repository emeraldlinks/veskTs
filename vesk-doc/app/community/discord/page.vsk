import { Link } from '@vesk/runtime/router'

component CommunityDiscord {
	<Head>
		<title>Discord — Build in the open | Vesk Community</title>
		<meta name="description" content="Vesk Discord: build in the open, office hours, #compiler, #native. Faster feedback than Next Discord, smaller but human." />
	</Head>
	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<p class="eyebrow mb-5 flex items-center gap-2"><span class="text-accent">·</span><span>community · discord</span></p>
		<h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Build in the open.</h1>
		<p class="mt-5 max-w-[60ch] font-mono text-[13px] leading-relaxed text-muted-foreground">Weekly office hours, <code class="bg-surface px-1 py-0.5">#compiler</code>, <code class="bg-surface px-1 py-0.5">#native</code>, <code class="bg-surface px-1 py-0.5">#showcase</code>. Ask about IR, not just CSS. No question is too low-level.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a href="https://discord.gg/vesk" target="_blank" rel="noopener" class="btn-solid px-5 py-3 text-sm no-underline">Join Discord ↗</a>
			<Link href="/community/github" class="btn-outline px-5 py-3 text-sm no-underline">GitHub →</Link>
		</div>

		<div class="mt-12 grid gap-px bg-border sm:grid-cols-3">
			for (const c of [
				{ title: "#compiler", desc: "Parser, IR, codegen. Ask why VDOM is 0 B.", vs: "vs Next #general — faster answers" },
				{ title: "#native", desc: "Kotlin emitter, Compose. Share tokens, not screenshots.", vs: "vs Flutter #random — closer to web" },
				{ title: "#showcase", desc: "Post your Fieldbook clone. Get per-cell perf review.", vs: "vs Svelte #showcase — compiler-level feedback" },
			]) {
				<div class="bg-surface p-5">
					<h3 class="font-display text-sm font-semibold">{c.title}</h3>
					<p class="mt-1.5 font-mono text-[11.5px] leading-relaxed text-muted-foreground">{c.desc}</p>
					<p class="mt-2 font-mono text-[11px] text-accent">{c.vs}</p>
				</div>
			}
		</div>

		<div class="panel mt-8 p-6">
			<h3 class="font-display text-sm font-semibold">Why Vesk Discord feels different</h3>
			<ul class="mt-3 list-disc pl-5 font-mono text-[12px] leading-relaxed text-muted-foreground space-y-1">
				<li><strong class="text-foreground">Compiler-first:</strong> core team answers with IR dumps, not StackOverflow links.</li>
				<li><strong class="text-foreground">No WebView cargo-cult:</strong> native is Kotlin, not wrapped Chrome — ask how offline.vsk becomes Compose.</li>
				<li><strong class="text-foreground">Marketing is optional:</strong> we sell by showing commits, not decks.</li>
			</ul>
			<p class="mt-3 font-mono text-[11px] text-muted-foreground">Compare: Next Discord 100k+ — great reach, slow triage. Vesk ~1k — you talk to the person who wrote the parser.</p>
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<Link href="/community/discussions" class="btn-solid px-6 py-3 text-sm no-underline">Discussions →</Link>
			<Link href="/examples" class="btn-outline px-6 py-3 text-sm no-underline">See examples</Link>
		</div>
	</div>
}
