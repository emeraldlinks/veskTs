import type { Component } from '@vesk/types';

interface LayoutProps {
	children?: Component
}

component Layout(props: LayoutProps) {
	<Head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0,400;9..144,1,400;9..144,1,500&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="icon" href="/favicon.svg" />
	</Head>
	<div class="min-h-screen bg-background text-foreground antialiased">
		{props.children}
	</div>
}
