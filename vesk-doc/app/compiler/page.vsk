import { Link } from '@vesk/runtime/router'

component Compiler {
	<Head>
		<title>Compiler — Vesk's compiler-first pipeline | Vesk</title>
		<meta name="description" content="Vesk's 4-stage compiler: preprocess, parse, IR, platform codegen. Zero virtual DOM, static analysis, AOT guarantees. Faster than Babel/SWC, more than a bundler — it's the product." />
	</Head>
	<div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
		<p class="eyebrow mb-5 flex items-center gap-2"><span class="text-accent">01</span><span>product · compiler</span></p>
		<h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">The compiler is the product.</h1>
		<p class="mt-5 max-w-[62ch] font-mono text-[13px] leading-relaxed text-muted-foreground">Next.js ships React to the browser and hopes the runtime is fast enough. Svelte hides the runtime but still carries a scheduler. Vesk moves the work to build time — your app is proven good before a byte leaves the server.</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Link href="/docs/pipeline" class="btn-solid px-5 py-3 text-sm no-underline">Explore pipeline →</Link>
			<Link href="/features" class="btn-outline px-5 py-3 text-sm no-underline">Why it matters</Link>
		</div>

		<div class="mt-14 grid gap-px bg-border sm:grid-cols-2">
			<div class="bg-surface p-6">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">01 · preprocess</p>
				<h3 class="mt-3 font-display text-base font-semibold">Source prepass</h3>
				<p class="mt-2 font-mono text-[12px] leading-relaxed text-muted-foreground">Statement-mode clauses (<code class="bg-background px-1 py-0.5">; key</code> / <code class="bg-background px-1 py-0.5">; index</code>), <code class="bg-background px-1 py-0.5">&lt;style&gt;</code> hoisting, island <code class="bg-background px-1 py-0.5">{`{#client}`}</code> tagging — offset-preserving, no regex.</p>
			</div>
			<div class="bg-surface p-6">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">02 · parse</p>
				<h3 class="mt-3 font-display text-base font-semibold">Acorn + VeskPlugin</h3>
				<p class="mt-2 font-mono text-[12px] leading-relaxed text-muted-foreground">Full TypeScript superset. <code class="bg-background px-1 py-0.5">component</code>, JSX-as-statement, <code class="bg-background px-1 py-0.5">&[track]</code> atoms, generics — all typed, all surfaced to tsc via <code class="bg-background px-1 py-0.5">vskToTsx</code>.</p>
			</div>
			<div class="bg-surface p-6">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">03 · IR</p>
				<h3 class="mt-3 font-display text-base font-semibold">Flat intermediate representation</h3>
				<p class="mt-2 font-mono text-[12px] leading-relaxed text-muted-foreground">Validated, dispatch-friendly: <code class="bg-background px-1 py-0.5">StaticNode</code>, <code class="bg-background px-1 py-0.5">MapRegion</code>, <code class="bg-background px-1 py-0.5">TrackDecl</code>, Islands. One IR, two web emitters + Kotlin.</p>
			</div>
			<div class="bg-surface p-6">
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">04 · codegen</p>
				<h3 class="mt-3 font-display text-base font-semibold">Platform emit</h3>
				<p class="mt-2 font-mono text-[12px] leading-relaxed text-muted-foreground">Server HTML chunks + client DOM + hydration markers; or Kotlin via <code class="bg-background px-1 py-0.5">vesk-native-compiler</code>. Static subtrees get zero hydration runtime.</p>
			</div>
		</div>

		<div class="panel mt-10 overflow-hidden">
			<div class="flex items-center justify-between border-b border-border px-4 py-2">
				<span class="eyebrow">vs. the bundler mindset</span>
				<span class="font-mono text-[10px] text-muted-foreground">compile errors &gt; runtime bugs</span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full font-mono text-[12px]">
					<thead class="bg-surface/60 text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
						<tr><th class="px-4 py-3 text-left font-medium">Capability</th><th class="px-4 py-3 text-left font-medium">Vesk</th><th class="px-4 py-3 text-left font-medium">Next.js / Vite + React</th><th class="px-4 py-3 text-left font-medium">SvelteKit</th></tr>
					</thead>
					<tbody class="divide-y divide-border">
						<tr><td class="px-4 py-3">Virtual DOM in production</td><td class="px-4 py-3 text-accent">None — direct DOM writes</td><td class="px-4 py-3">Yes (React reconciler)</td><td class="px-4 py-3">Scheduler + runtime helpers</td></tr>
						<tr><td class="px-4 py-3">Zero-JS pages</td><td class="px-4 py-3">Proven at build, 0 B</td><td class="px-4 py-3">Always ships runtime</td><td class="px-4 py-3">Partial, manual</td></tr>
						<tr><td class="px-4 py-3">Event delegation</td><td class="px-4 py-3">AOT — one listener per type</td><td class="px-4 py-3">Synthetic + per-tree</td><td class="px-4 py-3">Per-component</td></tr>
						<tr><td class="px-4 py-3">Static subtree cost</td><td class="px-4 py-3">No marker, no JS</td><td class="px-4 py-3">Hydrated anyway</td><td class="px-4 py-3">Reduced but present</td></tr>
						<tr><td class="px-4 py-3">Cross-platform</td><td class="px-4 py-3">Web + Kotlin (one IR)</td><td class="px-4 py-3">Web only</td><td class="px-4 py-3">Web only</td></tr>
						<tr><td class="px-4 py-3">Typecheck</td><td class="px-4 py-3"><code class="bg-surface px-1.5 py-0.5">vesk typecheck</code> via tsc</td><td class="px-4 py-3">tsc separate</td><td class="px-4 py-3">svelte-check</td></tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">What you write</h3>
				<pre class="mt-3 overflow-auto bg-background p-4 font-mono text-[11.5px] leading-relaxed"><code>{`component Counter() {
  let &[count] = track(0)
  <button onClick={() => count++}>Count: {count}</button>
}`}</code></pre>
				<p class="mt-3 font-mono text-[11px] text-muted-foreground">One model, no hooks, no useState. &amp;[] is sugar — compiler rewrites to get/set and per-cell effects.</p>
			</div>
			<div class="panel p-6">
				<h3 class="font-display text-sm font-semibold">What ships</h3>
				<pre class="mt-3 overflow-auto bg-background p-4 font-mono text-[11.5px] leading-relaxed"><code>{`// no VDOM
const $el = document.createElement('button')
effect(() => $el.textContent = \`Count: \${get(count)}\`)
$el.addEventListener('click', () => set(count, get(count)+1))`}</code></pre>
				<p class="mt-3 font-mono text-[11px] text-muted-foreground">O(1) text update, not O(n) VDOM diff. Static neighbors never re-render.</p>
			</div>
		</div>

		<div class="mt-12 flex flex-wrap gap-3">
			<Link href="/docs/pipeline" class="btn-solid px-6 py-3 text-sm no-underline">Read pipeline deep-dive</Link>
			<Link href="/features" class="btn-outline px-6 py-3 text-sm no-underline">All features</Link>
			<Link href="/comparison" class="font-mono text-[11px] text-muted-foreground hover:text-foreground py-3 px-2 no-underline">Full framework comparison →</Link>
		</div>
	</div>
}
