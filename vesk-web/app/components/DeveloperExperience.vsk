import { track } from '@vesk/runtime'
import { effect } from '@vesk/runtime'

component DeveloperExperience {
	let &[termStep] = track(4)

	effect(() => {
		const id = setInterval(() => {
			termStep = termStep >= 4 ? 0 : termStep + 1
			if (termStep === 0) {
				setTimeout(() => { termStep = 1 }, 500)
				setTimeout(() => { termStep = 2 }, 1100)
				setTimeout(() => { termStep = 3 }, 1700)
				setTimeout(() => { termStep = 4 }, 2300)
			}
		}, 4000)
		return () => clearInterval(id)
	})
	<section id="dx" class="border-b border-zinc-800 bg-black text-white">
		<div class="mx-auto max-w-[1200px] px-6 py-16 md:py-24">
			<div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-10 items-center">
				<div>
					<div class="inline-flex items-center border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest uppercase text-zinc-400">Developer experience</div>
					<h2 class="mt-4 text-[30px] md:text-[38px] font-black tracking-[-0.04em] leading-[0.95]">Feels instant.<br /><span class="text-zinc-400">Stays correct.</span></h2>
					<p class="mt-4 text-[15px] leading-6 text-zinc-400 max-w-[480px]">A fast, precise workflow with clear feedback. The compiler tells you what’s wrong - before the browser does.</p>
					<div class="mt-6 flex flex-wrap gap-2 text-[11px] font-mono">
						<span class=" bg-zinc-900 text-zinc-100 px-3 py-1 font-semibold">npm create vesk@latest</span>
						<span class=" border border-white/15 bg-white/5 px-3 py-1 text-zinc-600">npm run dev</span>
						<span class=" border border-white/15 bg-white/5 px-3 py-1 text-zinc-600">HMR enabled</span>
					</div>
					<div class="mt-8 grid grid-cols-3 gap-3 max-w-[420px]">
						<div class=" border border-white/10 bg-white/5 p-3 text-center">
							<div class="text-[18px] font-bold">48ms</div>
							<div class="text-[11px] text-zinc-400">rebuild</div>
						</div>
						<div class=" border border-white/10 bg-white/5 p-3 text-center">
							<div class="text-[18px] font-bold">0 config</div>
							<div class="text-[11px] text-zinc-400">TypeScript</div>
						</div>
						<div class=" border border-white/10 bg-white/5 p-3 text-center">
							<div class="text-[18px] font-bold">100%</div>
							<div class="text-[11px] text-zinc-400">typed</div>
						</div>
					</div>
				</div>

				<div class=" border border-white/10 bg-zinc-900/[0.04] overflow-hidden backdrop-blur">
					<div class="flex items-center justify-between border-b border-white/10 bg-zinc-900/[0.04] px-4 py-3">
						<div class="flex items-center gap-1.5">
							<span class="h-2.5 w-2.5 bg-zinc-900/15"></span>
							<span class="h-2.5 w-2.5 bg-zinc-900/15"></span>
							<span class="h-2.5 w-2.5 bg-zinc-900/15"></span>
							<span class="ml-3 font-mono text-[12px] text-zinc-400">terminal - zsh</span>
						</div>
						<span class="h-2 w-2 bg-emerald-500 animate-pulse"></span>
					</div>
					<div class="p-5 font-mono text-[13px] leading-6">
						<div class="text-zinc-400">$ <span class="text-white">npm create vesk@latest</span></div>
						<div class={termStep >= 1 ? "text-emerald-400" : "text-zinc-400"}>{termStep >= 1 ? "✓ Project created at ./my-app" : "· scaffolding..."} </div>
						<div class="text-zinc-400 mt-2">$ <span class="text-white">cd my-app && npm run dev</span></div>
						<div class={termStep >= 2 ? "text-emerald-400" : "text-zinc-400"}>{termStep >= 2 ? "✓ Vesk compiler ready" : "· starting compiler..."} </div>
						<div class={termStep >= 3 ? "text-emerald-400" : "text-zinc-400"}>{termStep >= 3 ? "✓ Development server started - http://localhost:3000" : "· starting dev server..."} </div>
						<div class={termStep >= 3 ? "text-emerald-400" : "text-zinc-400"}>{termStep >= 3 ? "✓ HMR enabled" : "· enabling HMR..."} </div>
						<div class={termStep >= 4 ? "text-emerald-400" : "text-zinc-400"}>{termStep >= 4 ? "✓ Application running" : "· compiling 23 modules..."} </div>
						<div class="mt-4 flex items-center gap-2">
							<span class="h-2 w-2 bg-emerald-500"></span>
							<span class="text-[11px] text-zinc-400">Watching for changes • Press h to show help</span>
						</div>
						<div class="mt-3 h-1.5 w-full bg-zinc-900/10 overflow-hidden">
							<div class={termStep === 4 ? "h-full bg-emerald-500 w-full transition-all duration-500" : termStep === 3 ? "h-full bg-emerald-500 w-3/4 transition-all duration-500" : termStep === 2 ? "h-full bg-emerald-500 w-1/2 transition-all duration-500" : termStep === 1 ? "h-full bg-emerald-500 w-1/4 transition-all duration-500" : "h-full bg-zinc-900/20 w-0"}></div>
						</div>
					</div>
					<div class="border-t border-white/10 bg-zinc-900/[0.03] px-4 py-3 flex items-center justify-between">
						<span class="font-mono text-[11px] text-zinc-400">Tip: edit app/page.vsk - HMR preserves state</span>
						<span class=" bg-zinc-900 px-2.5 py-1 text-[11px] font-semibold text-zinc-100">Try it →</span>
					</div>
				</div>
			</div>
		</div>
	</section>
}