import { track } from '@vesk/runtime'
import { Link } from '@vesk/runtime/router'

component Home {
	<Head>
		<title>Vesk — The compiler-first framework for modern applications</title>
		<meta name="description" content="Vesk is a compiler-first framework for modern applications. Build once, compile everywhere — web and native Kotlin from a single .vsk source." />
	</Head>
	let &[codeMode] = track('vesk')
	let &[activeStage] = track(2)
	let &[termStep] = track(4)
	let &[showCompiled] = track(false)

	effect(() => {
		const id = setInterval(() => {
			termStep = termStep >= 4 ? 0 : termStep + 1
			if (termStep === 0) {
				setTimeout(() => { termStep = 1 }, 500)
				setTimeout(() => { termStep = 2 }, 1100)
				setTimeout(() => { termStep = 3 }, 1700)
				setTimeout(() => { termStep = 4 }, 2300)
			}
		}, 4000)
		return () => clearInterval(id)
	})

	<div class="bg-zinc-900">
		<section class="relative overflow-hidden border-b border-zinc-800">
			<div class="absolute inset-0 pointer-events-none">
				<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.07)_1px,transparent_1px)] bg-[size:32px_32px] opacity-40"></div>
				<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.06),transparent_70%)]"></div>
			</div>
			<div class="relative mx-auto max-w-[1200px] px-6 py-16 md:py-24 lg:py-28">
				<div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-8 items-center">
					<div>
						<div class="inline-flex items-center gap-2  border border-zinc-800 bg-zinc-900 px-3 py-1 text-[11px] font-medium tracking-wide text-zinc-400 ">
							<span class="h-1.5 w-1.5  bg-emerald-500"></span>
							Compiler-first • v0.2.9 now available
							<span class="hidden sm:inline text-zinc-600">-</span>
							<Link href="/#docs" class="hidden sm:inline text-zinc-100 underline decoration-zinc-600 underline-offset-4 hover:decoration-emerald-400 no-underline">Read release notes →</Link>
						</div>
						<h1 class="mt-6 text-[42px] md:text-[56px] lg:text-[64px] font-black tracking-[-0.05em] leading-[0.9] text-zinc-100">
							Build once.<br />
							<span class="text-zinc-400">Compile</span> everywhere.
						</h1>
						<p class="mt-5 max-w-[560px] text-[16px] md:text-[17px] leading-7 text-zinc-400">
							Vesk is a compiler-first framework for modern applications. Write with a familiar component model - the compiler transforms it into optimized web and native Kotlin output.
						</p>
						<div class="mt-8 flex flex-wrap items-center gap-3">
							<Link href="#dx" class="inline-flex items-center justify-center  bg-zinc-900 px-6 py-3 text-[14px] font-semibold text-white hover:bg-black transition-colors  no-underline">
								Get Started
								<span class="ml-2 text-zinc-400">→</span>
							</Link>
							<Link href="/docs" class="inline-flex items-center justify-center  border border-zinc-800 bg-zinc-900 px-6 py-3 text-[14px] font-semibold text-zinc-100 hover:bg-black hover:border-zinc-700 transition-colors no-underline">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
								Explore the Docs
							</Link>
						</div>
						<div class="mt-8 flex flex-wrap items-center gap-6 text-[12.5px] text-zinc-400">
							<span class="inline-flex items-center gap-2"><span class="h-2 w-2  bg-zinc-900"></span> TypeScript • .vsk • Tailwind</span>
							<span class="inline-flex items-center gap-2"><span class="h-2 w-2  bg-zinc-900"></span> Web & Kotlin Native targets</span>
							<span class="inline-flex items-center gap-2"><span class="h-2 w-2  bg-zinc-900"></span> MIT Licensed</span>
						</div>
						<div class="mt-10 flex items-center gap-3 text-[12px] text-zinc-400">
							<span>Trusted for ambitious builds</span>
							<div class="h-px w-8 bg-zinc-800"></div>
							<span class="font-mono">npm create vesk@latest</span>
						</div>
					</div>

					<div class="relative lg:pl-6">
						<div class="relative  border border-zinc-800 bg-zinc-900  overflow-hidden">
							<div class="flex items-center justify-between border-b border-zinc-800 bg-black px-4 py-3">
								<div class="flex items-center gap-1.5">
									<span class="h-3 w-3  bg-zinc-800"></span>
									<span class="h-3 w-3  bg-zinc-800"></span>
									<span class="h-3 w-3  bg-zinc-800"></span>
								</div>
								<span class=" bg-zinc-900 border border-zinc-800 px-2.5 py-1 text-[10px] font-semibold tracking-widest uppercase text-zinc-400">Compiler pipeline</span>
								<span class="text-[11px] font-mono text-zinc-400">vesk compile</span>
							</div>
							<div class="p-6 sm:p-8">
								<div class="flex flex-col items-center gap-0">
									<div class="w-full max-w-[320px] -xl border border-zinc-800 bg-zinc-900 px-4 py-3 flex items-center justify-between ">
										<div class="flex items-center gap-3">
											<div class="h-8 w-8 -lg bg-zinc-900 flex items-center justify-center">
												<span class="text-white text-[11px] font-bold">.vsk</span>
											</div>
											<div>
												<div class="text-[13px] font-semibold tracking-[-0.02em] text-zinc-100">app/page.vsk</div>
												<div class="text-[11px] font-mono text-zinc-400">component App {'{'} ... {'}'}</div>
											</div>
										</div>
										<span class="h-2 w-2  bg-emerald-500 animate-pulse"></span>
									</div>
									<div class="flex flex-col items-center">
										<div class="h-8 w-px bg-zinc-800"></div>
										<div class="h-7 w-7  border border-zinc-800 bg-zinc-900 flex items-center justify-center ">
											<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
										</div>
										<div class="h-8 w-px bg-zinc-800"></div>
									</div>
									<div class="w-full max-w-[320px] -xl border border-zinc-900 bg-zinc-900 px-4 py-3.5 flex items-center justify-between ">
										<div class="flex items-center gap-3">
											<div class="h-8 w-8 -lg bg-zinc-900 flex items-center justify-center">
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#18181b" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
											</div>
											<div>
												<div class="text-[13px] font-semibold tracking-[-0.02em] text-white">Vesk Compiler</div>
												<div class="text-[11px] font-mono text-zinc-400">parse → analyze → optimize</div>
											</div>
										</div>
										<span class=" bg-zinc-900/10 border border-white/15 px-2 py-1 text-[10px] font-medium tracking-widest uppercase text-white">AOT</span>
									</div>
									<div class="flex flex-col items-center">
										<div class="h-8 w-px bg-zinc-800"></div>
										<div class="h-7 w-7  border border-zinc-800 bg-zinc-900 flex items-center justify-center ">
											<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
										</div>
										<div class="h-8 w-px bg-zinc-800"></div>
									</div>
									<div class="grid grid-cols-2 gap-3 w-full max-w-[320px]">
										<div class=" border border-zinc-800 bg-zinc-900 p-3 flex items-center gap-3">
											<div class="h-8 w-8 -lg bg-[#0a0a0a] flex items-center justify-center">
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10A15.3 15.3 0 0 1 12 2z"/></svg>
											</div>
											<div>
												<div class="text-[12.5px] font-semibold text-zinc-100">Web</div>
												<div class="text-[11px] font-mono text-zinc-400">ESM + SSR</div>
											</div>
										</div>
										<div class=" border border-zinc-800 bg-zinc-900 p-3 flex items-center gap-3">
											<div class="h-8 w-8 -lg bg-[#7F52FF] flex items-center justify-center">
												<span class="text-white text-[10px] font-black">K</span>
											</div>
											<div>
												<div class="text-[12.5px] font-semibold text-zinc-100">Kotlin</div>
												<div class="text-[11px] font-mono text-zinc-400">Native • M3</div>
											</div>
										</div>
									</div>
								</div>
								<div class="mt-6 -xl bg-black border border-zinc-800 p-3 flex items-center justify-between">
									<span class="text-[11px] font-mono text-zinc-400">✓ 142 modules compiled in 48ms</span>
									<span class="text-[11px] font-mono text-emerald-400">0 warnings</span>
								</div>
							</div>
						</div>
						<div class="absolute -z-10 -bottom-6 -right-6 h-32 w-32  bg-white/5 blur-2xl"></div>
						<div class="absolute -z-10 -top-6 -left-6 h-24 w-24  bg-white/5 blur-2xl"></div>
					</div>
				</div>
				<div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-3 border-t border-zinc-800 pt-8">
					<div class="flex items-center gap-3">
						<div class="h-8 w-8  border border-zinc-800 bg-zinc-900 flex items-center justify-center"><span class="text-[11px] font-bold">TS</span></div>
						<div><div class="text-[13px] font-semibold">TypeScript</div><div class="text-[11px] text-zinc-400">Full support</div></div>
					</div>
					<div class="flex items-center gap-3">
						<div class="h-8 w-8  border border-zinc-800 bg-zinc-900 flex items-center justify-center"><span class="text-[11px] font-bold">TW</span></div>
						<div><div class="text-[13px] font-semibold">Tailwind CSS</div><div class="text-[11px] text-zinc-400">Utility-first</div></div>
					</div>
					<div class="flex items-center gap-3">
						<div class="h-8 w-8  bg-zinc-900 flex items-center justify-center"><span class="text-white text-[10px] font-bold">npm</span></div>
						<div><div class="text-[13px] font-semibold">npm ecosystem</div><div class="text-[11px] text-zinc-400">Compatible</div></div>
					</div>
					<div class="flex items-center gap-3">
						<div class="h-8 w-8  border border-zinc-800 bg-zinc-900 flex items-center justify-center"><span class="text-[11px]">◍</span></div>
						<div><div class="text-[13px] font-semibold">Framer Motion</div><div class="text-[11px] text-zinc-400">Animation</div></div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-b border-zinc-800 bg-black text-white">
			<div class="mx-auto max-w-[1200px] px-6 py-12 md:py-16">
				<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
					<div>
						<div class="inline-flex items-center gap-2  border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-medium tracking-widest uppercase text-zinc-400">
							<span class="h-1.5 w-1.5  bg-zinc-900"></span>
							Interactive code showcase
						</div>
						<h2 class="mt-4 text-[28px] md:text-[36px] font-bold tracking-[-0.03em] leading-none">Code is the product.</h2>
						<p class="mt-3 max-w-[560px] text-[14px] leading-6 text-zinc-400">
							Write modern Vesk with Expression Mode. The compiler understands your intent, validates semantics at build time, and emits optimized output.
						</p>
					</div>
					<div class="flex items-center gap-2  border border-white/10 bg-white/5 p-1">
						<button onClick={() => { codeMode = 'vesk'; showCompiled = false }} class={codeMode === 'vesk' ? " bg-zinc-900 px-4 py-1.5 text-[13px] font-semibold text-zinc-100 " : " px-4 py-1.5 text-[13px] font-medium text-zinc-400 hover:text-white"}>Vesk source</button>
						<button onClick={() => { codeMode = 'compiled'; showCompiled = true }} class={codeMode === 'compiled' ? " bg-zinc-900 px-4 py-1.5 text-[13px] font-semibold text-zinc-100 " : " px-4 py-1.5 text-[13px] font-medium text-zinc-400 hover:text-white"}>Compiled</button>
					</div>
				</div>

				<div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-6">
					<div class=" border border-white/10 bg-zinc-900/[0.04] backdrop-blur overflow-hidden">
						<div class="flex items-center justify-between border-b border-white/10 bg-zinc-900/[0.04] px-4 py-3">
							<div class="flex items-center gap-2">
								<span class="h-2.5 w-2.5  bg-zinc-900/15"></span>
								<span class="h-2.5 w-2.5  bg-zinc-900/15"></span>
								<span class="h-2.5 w-2.5  bg-zinc-900/15"></span>
								<span class="ml-3 font-mono text-[12px] text-zinc-400">app/page.vsk</span>
							</div>
							<span class="hidden sm:inline-flex  border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-medium tracking-widest uppercase text-zinc-600">{codeMode === 'vesk' ? "Statement mode" : "Optimized output"}</span>
						</div>
						<div class="p-5 md:p-6 font-mono text-[13px] leading-6">
							if (codeMode === 'vesk') {
								<div>
									<div><span class="text-zinc-400">1</span> <span class="text-[#ff7ab2]">component</span> <span class="text-white font-semibold">App</span> <span class="text-zinc-400">{'{'}</span></div>
									<div><span class="text-zinc-400">2</span> <span class="text-white">  {'<'}<span class="text-[#7cc4ff]">main</span> <span class="text-[#ffd60a]">class</span>=<span class="text-[#a6e3a1]">"min-h-screen flex items-center justify-center"</span>{'>'}</span></div>
									<div><span class="text-zinc-400">3</span> <span class="text-white">  {'<'}<span class="text-[#7cc4ff]">h1</span> <span class="text-[#ffd60a]">class</span>=<span class="text-[#a6e3a1]">"text-4xl font-bold tracking-tight"</span>{'>'}Hello, Vesk.{'</'}<span class="text-[#7cc4ff]">h1</span>{'>'}</span></div>
									<div><span class="text-zinc-400">4</span> <span class="text-white">  {'<'}<span class="text-[#7cc4ff]">p</span> <span class="text-[#ffd60a]">class</span>=<span class="text-[#a6e3a1]">"text-zinc-400 mt-2"</span>{'>'}The compiler-first framework.{'</'}<span class="text-[#7cc4ff]">p</span>{'>'}</span></div>
									<div><span class="text-zinc-400">5</span> <span class="text-white">  {'</'}<span class="text-[#7cc4ff]">main</span>{'>'}</span></div>
									<div><span class="text-zinc-400">6</span> <span class="text-zinc-400">{'}'}</span></div>
									<div class="mt-4 h-px bg-zinc-900/10"></div>
									<div class="mt-3 text-[11px] text-zinc-400">Write modern Vesk code → Vesk understands it → Vesk compiles it → ship.</div>
								</div>
							} else {
								<div>
									<div><span class="text-zinc-400">1</span> <span class="text-zinc-400">// compiled output - fine-grained reactivity, no VDOM</span></div>
									<div><span class="text-zinc-400">2</span> <span class="text-[#ff7ab2]">export</span> <span class="text-white">function</span> <span class="text-[#7cc4ff]">App</span>() {'{'}</div>
									<div><span class="text-zinc-400">3</span> <span class="text-white">  {'const el = template(`'}<span class="text-[#a6e3a1]">{'<main><h1></h1><p></p></main>'}</span>{'`)'}</span></div>
									<div><span class="text-zinc-400">4</span> <span class="text-white">  {'claim(`'}<span class="text-[#a6e3a1]">{'h1'}</span>{'`) · set_text('}<span class="text-[#a6e3a1]">{'"Hello, Vesk."'}</span>{') · hydrate()'}</span></div>
									<div><span class="text-zinc-400">5</span> <span class="text-white">  {'return el'}</span></div>
									<div><span class="text-zinc-400">6</span> {'}'}</div>
									<div class="mt-4 flex items-center gap-2 text-[11px]">
										<span class=" bg-emerald-500/15 border border-emerald-500/20 px-2 py-1 text-emerald-300">✓ 0.9 kB gzipped</span>
										<span class=" bg-white/5 border border-white/10 px-2 py-1 text-zinc-400">no runtime VDOM</span>
									</div>
								</div>
							}
						</div>
						<div class="border-t border-white/10 bg-zinc-900/[0.03] px-4 py-3 flex items-center justify-between">
							<span class="font-mono text-[11px] text-zinc-400">transform in 12ms • deterministic • no hidden runtime</span>
							<button onClick={() => showCompiled = !showCompiled} class=" bg-zinc-900 px-3 py-1 text-[12px] font-semibold text-zinc-100 hover:bg-zinc-800/60">
								{showCompiled ? "Show source" : "Show compiled →"}
							</button>
						</div>
					</div>

					<div class=" border border-white/10 bg-zinc-900 overflow-hidden text-zinc-100">
						<div class="border-b border-zinc-800 bg-black px-4 py-3 flex items-center justify-between">
							<span class="text-[12px] font-semibold tracking-[-0.02em]">Live preview</span>
							<span class=" bg-zinc-900 border border-zinc-800 px-2 py-1 text-[10px] font-medium tracking-widest uppercase text-zinc-400">SSR + Hydration</span>
						</div>
						<div class="p-8">
							<div class="min-h-[180px] flex flex-col items-center justify-center -xl border border-zinc-800 bg-zinc-900 p-8 ">
								<h1 class="text-4xl font-black tracking-[-0.04em]">Hello, Vesk.</h1>
								<p class="text-zinc-400 mt-2 text-[13px]">The compiler-first framework.</p>
								<div class="mt-6 h-px w-full bg-zinc-800/60"></div>
								<div class="mt-4 flex items-center gap-2 text-[11px] font-mono text-zinc-400">
									<span class="h-2 w-2  bg-emerald-500"></span> Hydrated • interactive • 0 JS until needed
								</div>
							</div>
							<div class="mt-4 grid grid-cols-3 gap-3 text-center">
								<div class=" border border-zinc-800 bg-black p-3">
									<div class="text-[18px] font-bold tracking-tight">48ms</div>
									<div class="text-[11px] text-zinc-400">compile</div>
								</div>
								<div class=" border border-zinc-800 bg-black p-3">
									<div class="text-[18px] font-bold tracking-tight">0.9kB</div>
									<div class="text-[11px] text-zinc-400">runtime</div>
								</div>
								<div class=" border border-zinc-800 bg-black p-3">
									<div class="text-[18px] font-bold tracking-tight">100</div>
									<div class="text-[11px] text-zinc-400">lighthouse</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="why" class="border-b border-zinc-800">
			<div class="mx-auto max-w-[1200px] px-6 py-16 md:py-24">
				<div class="max-w-[720px]">
					<div class="inline-flex items-center  border border-zinc-800 bg-black px-3 py-1 text-[11px] font-semibold tracking-widest uppercase text-zinc-400">Why Vesk</div>
					<h2 class="mt-4 text-[32px] md:text-[42px] font-black tracking-[-0.04em] leading-[0.95] text-zinc-100">
						Move guarantees<br />to <span class="text-zinc-400">build time.</span>
					</h2>
					<p class="mt-4 text-[15px] leading-6 text-zinc-400 max-w-[560px]">
						Vesk is not “another framework.” It’s a compiler that preserves your semantics, eliminates unnecessary runtime, and fails the build instead of shipping broken native behavior.
					</p>
				</div>

				<div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
					<div class=" border border-zinc-800 bg-zinc-900 p-6 hover:border-zinc-700 hover: transition-colors">
						<div class="h-9 w-9 -xl bg-zinc-900 flex items-center justify-center">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M10 13H8"/><path d="M16 17H8"/><path d="M13 13h3"/></svg>
						</div>
						<h3 class="mt-4 text-[15px] font-semibold tracking-[-0.02em]">Compiler First</h3>
						<p class="mt-2 text-[13.5px] leading-5 text-zinc-400">Important guarantees move from runtime to build time. If semantics can’t be preserved, the build fails.</p>
						<div class="mt-4 inline-flex  bg-black border border-zinc-800 px-2.5 py-1 text-[11px] font-mono text-zinc-400">fail-fast · deterministic</div>
					</div>
					<div class=" border border-zinc-800 bg-zinc-900 p-6 hover:border-zinc-700 hover: transition-colors">
						<div class="h-9 w-9 -xl bg-zinc-900 flex items-center justify-center">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="0"/><path d="M9 9h6v6H9z"/></svg>
						</div>
						<h3 class="mt-4 text-[15px] font-semibold tracking-[-0.02em]">One Development Model</h3>
						<p class="mt-2 text-[13.5px] leading-5 text-zinc-400">Consistent component and styling model across platforms. Learn once, target web and native.</p>
						<div class="mt-4 inline-flex  bg-black border border-zinc-800 px-2.5 py-1 text-[11px] font-mono text-zinc-400">.vsk · Tailwind</div>
