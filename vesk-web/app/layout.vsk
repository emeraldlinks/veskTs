				</Link>
				<nav class="hidden lg:flex items-center gap-1">
					<Link href="/#why" class="px-3 py-2 text-[13.5px] font-medium text-zinc-400 hover:text-emerald-400 transition-colors no-underline">Why Vesk</Link>
					<Link href="/#native" class="px-3 py-2 text-[13.5px] font-medium text-zinc-400 hover:text-emerald-400 transition-colors no-underline">Native</Link>
