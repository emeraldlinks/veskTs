			<div class="mx-auto max-w-[1200px] px-6 h-[64px] flex items-center justify-between gap-8">
				<div class="flex items-center gap-10">
<Link href="/" class="flex items-center gap-3 no-underline">
					<div class="w-8 h-8 border border-emerald-400 bg-black flex items-center justify-center">
