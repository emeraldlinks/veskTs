{
  "name": "@vesk/compiler",
  "version": "0.2.3",
  "type": "module",
  "description": "Vesk compiler — lexer, parser, semantic analysis, IR, codegen",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/acorn-ts-plugin', 'dist/acorn-ts-plugin', { recursive: true })\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.0",
    "acorn": "^8.15.0",
    "esrap": "^2.3.0",
    "is-reference": "^3.0.0",
    "source-map": "^0.7.4",
    "zimmerframe": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
