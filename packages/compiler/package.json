{
  "name": "@vesk/compiler",
  "version": "0.1.0",
  "type": "module",
  "description": "Vesk compiler — lexer, parser, semantic analysis, IR, codegen",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.0",
    "acorn": "^8.15.0",
    "esrap": "^2.3.0",
    "is-reference": "^3.0.0",
    "source-map": "^0.7.4",
    "zimmerframe": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
