#!/usr/bin/env node
import { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync, statSync, watch } from 'fs';
import { dirname, basename, resolve, join, relative, extname } from 'path';
import { compileClient } from '../src/client-codegen.js';
import { ssg, compileFile, renderPage, renderFullPage } from '../src/server-codegen.js';
import { scanRoutes, collectSources, generateRouteManifest, matchUrl, extractMiddleware } from '../src/router.js';
import { scanApiRoutes, matchApiUrl, buildWebRequest, executeApiRoute, parseCookies } from '../src/api-routes.js';
import { collectMiddlewareChain, executeMiddlewareChain } from '../src/middleware.js';
import { createServer } from 'node:http';

const args = process.argv.slice(2);
const cmd = args[0];

function usage(code = 0) {
	console.error(`Vesk CLI — Compiler-First Framework for the Post-VDOM Web`);
	console.error(``);
	console.error(`Usage:`);
	console.error(`  vesk init [project-name]    Create a new Vesk project`);
	console.error(`  vesk dev [port]             Start the dev server`);
	console.error(`  vesk build [options]        Build .vesk/ production output`);
	console.error(`  vesk <file.vsk> [options]   Compile a .vsk file`);
	console.error(`  vesk --router [options]     Build app/ with file-based routing`);
	console.error(`  vesk --help                 Show this help`);
	console.error(``);
	console.error(`Options:`);
	console.error(`  -o <file>     Output to file instead of stdout`);
	console.error(`  --ssg         Generate static HTML (Static Site Generation)`);
	console.error(`  --props <json>  Custom props for SSG`);
	console.error(`  --router      File-based routing (scans ./app/)`);
	console.error(`  --out-dir     Output directory for build (default: .vesk)`);
	process.exit(code);
}

if (args.length === 0 || args.includes('--help') || args.includes('-h')) {
	usage(args.length === 0 ? 1 : 0);
}

// ── init ─────────────────────────────────────────────────────
if (cmd === 'init') {
	const projectName = args[1] || '.';
	const targetDir = projectName === '.' ? process.cwd() : resolve(process.cwd(), projectName);
	if (targetDir !== process.cwd() && existsSync(targetDir)) {
		console.error(`vesk: directory "${projectName}" already exists`);
		process.exit(1);
	}
	const { execSync } = await import('child_process');
	const cliBin = resolve(dirname(import.meta.url.replace('file://', '')), '../../cli/src/index.js');
	execSync(`node "${cliBin}" init ${args.slice(1).map(a => `"${a}"`).join(' ')}`, { stdio: 'inherit' });
	process.exit(0);
}

// ── dev ──────────────────────────────────────────────────────
if (cmd === 'dev') {
	const projectDir = process.cwd();
	const appDirPath = resolve(projectDir, 'app');
	const publicDir = resolve(projectDir, 'public');
	const port = parseInt(args[1], 10) || 3000;

	if (!existsSync(appDirPath)) {
		console.error(`vesk: app/ directory not found. Run "vesk init" first.`);
		process.exit(1);
	}

	const adapterRoot = resolve(dirname(import.meta.url.replace('file://', '')), '../../adapter');
	const { startDevServer } = await import(resolve(adapterRoot, 'src/dev-server.js'));
	await startDevServer(appDirPath, { port, publicDir });
}

// ── build ─────────────────────────────────────────────────────
if (cmd === 'build') {
	const projectDir = process.cwd();
	const appDir = resolve(projectDir, 'app');
	const outDir = resolve(projectDir, args.includes('--out-dir') ? args[args.indexOf('--out-dir') + 1] || '.vesk' : '.vesk');
	const ssgEnabled = args.includes('--ssg');

	if (!existsSync(appDir)) {
		console.error(`vesk: app/ directory not found. Run "vesk init" first.`);
		process.exit(1);
	}

	try {
		const adapterRoot = resolve(dirname(import.meta.url.replace('file://', '')), '../../adapter');
		const adapter = await import(resolve(adapterRoot, 'src/index.js'));
		await adapter.build(appDir, { outDir, ssg: ssgEnabled });
	} catch (e) {
		console.error(`vesk build failed:`, e.message);
		if (e.stack) console.error(e.stack);
		process.exit(1);
	}
	process.exit(0);
}

function countRoutes(nodes) {
	let n = 0;
	for (const node of nodes) {
		if (node.page) n++;
		n += countRoutes(node.children || []);
	}
	return n;
}

const isSsg = args.includes('--ssg');
const isRouter = args.includes('--router');
const outIndex = args.indexOf('-o');
const outputArg = outIndex !== -1 ? args[outIndex + 1] : null;
const propsIndex = args.indexOf('--props');
const propsRaw = propsIndex !== -1 ? args[propsIndex + 1] : null;

// ── Router mode ────────────────────────────────────────────────
if (isRouter) {
	const appDir = resolve('./app');

	if (!existsSync(appDir)) {
		console.error(`vesk: app directory not found at ${appDir}`);
		console.error(`Create an app/ directory with page.vsk and layout.vsk files`);
		process.exit(1);
	}

	try {
		const tree = scanRoutes(appDir);
		if (tree.length === 0) {
			console.error('vesk: no routes found in', appDir);
			process.exit(1);
		}

		const hasLayout = tree.some(n => n.layout);
		const hasPage = tree.some(n => n.page);

		let output = `// Vesk Router — auto-generated from ${appDir}\n`;
		output += `import { createFileRouter, Link, Outlet, NavLink, useNavigate, useParams, usePathname, useSearchParams } from '@vesk/runtime';\n\n`;

		// Compile each .vsk source
		const sources = collectSources(tree);
		const seen = new Set();
		let hasOutputComponents = false;
		const actualNames = {};

		for (const [compName, sourceRel] of sources) {
			const sourcePath = resolve(appDir, sourceRel);
			if (seen.has(sourcePath)) continue;
			seen.add(sourcePath);
			try {
				const src = readFileSync(sourcePath, 'utf-8');
				const code = compileClient(src, null, { forceClient: true });
				if (!code) continue;
				// Strip runtime imports (they'll be in the HTML page)
				let cleaned = code.replace(/^import\s.*from\s['"]@vesk\/runtime['"];?\n?/gm, '');
	// Strip duplicate __components = {} and __cleanup (keep only first with content)
	if (hasOutputComponents) {
		cleaned = cleaned.replace(/^(?:const|let|var)\s+__components\s*=\s*\{\};\n?/m, '');
		cleaned = cleaned.replace(/function __cleanup[\s\S]*?\n\}/g, '');
	}
				hasOutputComponents = true;
				// Extract actual component names from __components["Foo"] assignments
				const nameRegex = /__components\["(\w+)"\]\s*=\s*\(/g;
				let match;
				while ((match = nameRegex.exec(cleaned)) !== null) {
					actualNames[compName] = match[1];
				}
				output += `// --- ${sourceRel} ---\n`;
				output += cleaned;
				output += '\n';
			} catch (e) {
				console.error(`vesk: failed to compile ${sourceRel}: ${e.message}`);
			}
		}

		// Patch route tree with actual component names
		function patchTree(nodes) {
			for (const node of nodes) {
				if (node.page && actualNames[node.page]) node.page = actualNames[node.page];
				if (node.layout && actualNames[node.layout]) node.layout = actualNames[node.layout];
				patchTree(node.children || []);
			}
		}
		patchTree(tree);

		// Collect middleware (all levels)
		const middlewareFiles = [];
		function collectMW(nodes) {
			for (const node of nodes) {
				if (node.hasMiddleware) {
					const mwPath = resolve(appDir, node.sourceDir, 'middleware.vsk');
					if (existsSync(mwPath)) middlewareFiles.push({ path: mwPath, node });
				}
				collectMW(node.children || []);
			}
		}
		collectMW(tree);

		// Route tree
		output += `\n// Route tree\n`;
		output += `const __routeTree = ${JSON.stringify(tree, null, 2)};\n\n`;

		// Middleware
		if (middlewareFiles.length > 0) {
			output += `// Middleware chain (root → leaf)\n`;
			const mwCode = [];
			for (const { path: mwPath, node } of middlewareFiles) {
				const src = extractMiddleware(mwPath);
				if (src) {
					mwCode.push(src);
				}
			}
			output += `const __middleware = [${mwCode.join(',\n')}];\n\n`;
		}

		// Bootstrap: Wait for DOM, then start the router
		output += `// Entry point\n`;
		output += `if (typeof document !== 'undefined') {\n`;
		output += `  if (document.readyState === 'loading') {\n`;
		output += `    document.addEventListener('DOMContentLoaded', () => {\n`;
		if (middlewareFiles.length > 0) {
			output += `      const router = createFileRouter(__routeTree, { middleware: __middleware });\n`;
		} else {
			output += `      const router = createFileRouter(__routeTree);\n`;
		}
		output += `      router.start();\n`;
		output += `    });\n`;
		output += `  } else {\n`;
		if (middlewareSrc) {
			output += `    const router = createFileRouter(__routeTree, { middleware: __middleware });\n`;
		} else {
			output += `    const router = createFileRouter(__routeTree);\n`;
		}
		output += `    router.start();\n`;
		output += `  }\n`;
		output += `}\n\n`;
		output += `export { createFileRouter, Link, Outlet, NavLink, useNavigate, useParams, usePathname, useSearchParams };\n`;
		output += `export default __routeTree;\n`;

		if (outputArg) {
			writeFileSync(outputArg, output);
			const routeCount = countRoutes(tree);
			const base = basename(outputArg);
			console.error(`vesk: wrote ${base} (${seen.size} components, ${routeCount} routes)`);
		} else {
			process.stdout.write(output);
		}
	} catch (e) {
		console.error(`vesk: router build failed: ${e.message}`);
		process.exit(1);
	}
	process.exit(0);
}

// ── Standard mode ──────────────────────────────────────────────
const inputFile = args[0];

let source;
try {
	source = readFileSync(inputFile, 'utf-8');
} catch (e) {
	console.error(`vesk: cannot read "${inputFile}": ${e.message}`);
	process.exit(1);
}

if (isSsg) {
	try {
		const customProps = propsRaw ? JSON.parse(propsRaw) : undefined;
		const { html: page, props } = ssg(source, null, customProps);

		const base = basename(inputFile, '.vsk');
		if (outputArg) {
			mkdirSync(outputArg, { recursive: true });
			writeFileSync(resolve(outputArg, base + '.html'), page);
			writeFileSync(resolve(outputArg, base + '.json'), props + '\n');
		} else {
			process.stdout.write(page);
		}
	} catch (e) {
		console.error(`vesk: ssg failed: ${e.message}`);
		process.exit(1);
	}
} else {
	let code;
	try {
		code = compileClient(source);
	} catch (e) {
		console.error(`vesk: compilation failed: ${e.message}`);
		process.exit(1);
	}

	if (outputArg) {
		writeFileSync(outputArg, code + '\n');
	} else {
		process.stdout.write(code + '\n');
	}
}
