{
  "name": "lucide-vesk",
  "version": "0.2.13",
  "type": "module",
  "description": "Lucide icons for Vesk — same props as lucide-react, fully typed, covers all icons, never scoped",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "npx tsx scripts/generate.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lucide": "^0.511.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.23.1"
  },
  "license": "ISC",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git",
    "directory": "packages/lucide-vesk"
  },
  "homepage": "https://lucide.dev",
  "bugs": {
    "url": "https://github.com/lucide-icons/lucide/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
