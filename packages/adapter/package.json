{
  "name": "@vesk/adapter",
  "version": "0.1.7",
  "type": "module",
  "description": "Vesk adapter — builds deployable .vesk/ output for Deno and Node serverless",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vesk/compiler": "^0.1.0",
    "@vesk/runtime": "^0.1.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ]
}
