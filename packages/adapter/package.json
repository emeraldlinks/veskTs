{
  "name": "@vesk/adapter",
  "version": "0.1.0",
  "type": "module",
  "description": "Vesk adapter — builds deployable .vesk/ output for Deno and Node serverless",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vesk/compiler": "^0.1.0",
    "@vesk/runtime": "^0.1.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0"
  }
}
