{
  "name": "@vesk/agentic",
  "version": "0.2.12",
  "type": "module",
  "description": "Vesk agentic plugin — zero-deps agent loop, provider abstraction, permissions, tools, checkpoints",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@vesk/types": "^0.2.12"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
