{
  "name": "@vesk/types",
  "version": "0.2.13",
  "type": "module",
  "description": "Vesk shared type definitions — the single source for all public framework types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
