{
  "name": "@vesk/docs",
  "version": "0.4.5",
  "type": "module",
  "description": "Vesk Intelligence Compiler — API-route intelligence, OpenAPI, and local Swagger UI docs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-swagger-ui.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vesk/compiler": "^0.4.5",
    "@vesk/types": "^0.4.5",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "swagger-ui-dist": "^5.35.1",
    "tsx": "^4.23.1"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
