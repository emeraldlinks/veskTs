{
  "name": "@vesk/runtime",
  "version": "0.2.81",
  "type": "module",
  "description": "Vesk runtime — reactivity, blocks, DOM operations, hydration",
  "main": "./dist/index-client.js",
  "types": "./dist/index-client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-client.d.ts",
      "default": "./dist/index-client.js"
    },
    "./client": {
      "types": "./dist/index-client.d.ts",
      "default": "./dist/index-client.js"
    },
    "./server": {
      "types": "./dist/index-server.d.ts",
      "default": "./dist/index-server.js"
    },
    "./router": {
      "types": "./dist/index-router.d.ts",
      "default": "./dist/index-router.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "default": "./dist/request.js"
    },
    "./security": {
      "types": "./dist/security-overrides.d.ts",
      "default": "./dist/security-overrides.js"
    },
    "./path-store": {
      "types": "./dist/path-store.d.ts",
      "default": "./dist/path-store.js"
    },
    "./store-persistence": {
      "types": "./dist/store-persistence.d.ts",
      "default": "./dist/store-persistence.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "router": [
        "dist/index-router.d.ts"
      ],
      "store": [
        "dist/store.d.ts"
      ],
      "path-store": [
        "dist/path-store.d.ts"
      ],
      "store-persistence": [
        "dist/store-persistence.d.ts"
      ],
      "client": [
        "dist/index-client.d.ts"
      ],
      "server": [
        "dist/index-server.d.ts"
      ],
      "src/*": [
        "dist/*"
      ],
      "router/*": [
        "dist/*"
      ],
      "client/*": [
        "dist/*"
      ],
      "server/*": [
        "dist/*"
      ]
    }
  },
  "dependencies": {
    "@vesk/compiler": "^0.2.81"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
