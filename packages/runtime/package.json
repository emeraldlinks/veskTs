{
  "name": "@vesk/runtime",
  "version": "0.2.6",
  "type": "module",
  "description": "Vesk runtime — reactivity, blocks, DOM operations, hydration",
  "main": "./dist/index-client.js",
  "types": "./dist/index-client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-client.d.ts",
      "default": "./dist/index-client.js"
    },
    "./client": {
      "types": "./dist/index-client.d.ts",
      "default": "./dist/index-client.js"
    },
    "./server": {
      "types": "./dist/index-server.d.ts",
      "default": "./dist/index-server.js"
    },
    "./src/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@vesk/compiler": "^0.2.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
