  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vesk/adapter": "^0.2.54",
    "@vesk/compiler": "^0.2.54",
    "@vesk/runtime": "^0.2.54",
    "@vesk/types": "^0.2.54",
    "linkedom": "^0.18.13"
  },
  "license": "MIT"
}
