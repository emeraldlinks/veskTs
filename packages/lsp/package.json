{
  "name": "@vesk/lsp",
  "version": "0.2.7",
  "type": "module",
  "description": "Vesk Language Server Protocol server for .vsk files",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vesk-lsp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@volar/language-core": "~2.4.28",
    "@volar/language-server": "~2.4.28",
    "@volar/language-service": "~2.4.28",
    "@volar/typescript": "~2.4.28",
    "@vesk/compiler": "^0.2.7",
    "@vesk/prettier-plugin": "^0.2.7",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "volar-service-css": "0.0.71",
    "volar-service-typescript": "0.0.71",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0",
    "vscode-uri": "^3.1.0",
    "vscode-css-languageservice": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "emeraldlinks",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs.git"
  },
  "homepage": "https://github.com/emeraldlinks/veskTs#readme",
  "bugs": {
    "url": "https://github.com/emeraldlinks/veskTs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
