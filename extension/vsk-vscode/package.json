{
  "name": "vesk-vscode",
  "displayName": "Vesk Language Support",
  "description": "Language support for .vsk component files",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "publisher": "vesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/emeraldlinks/veskTs"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "vesk",
    "vsk",
    ".vsk"
  ],
  "activationEvents": [
    "onLanguage:vsk"
  ],
  "configuration": {
    "title": "Vesk",
    "properties": {
      "vesk.tailwind.completion": {
        "type": "boolean",
        "default": true,
        "description": "Enable Tailwind CSS class completion in class attributes"
      },
      "vesk.tagAutoClose": {
        "type": "boolean",
        "default": true,
        "description": "Automatically insert closing tags when typing '>'"
      },
      "vesk.lsp.trace.server": {
        "type": "string",
        "enum": ["off", "messages", "verbose"],
        "default": "off",
        "description": "Trace LSP server communication"
      }
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vsk",
        "aliases": [
          "Vesk",
          "vsk"
        ],
        "extensions": [
          ".vsk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "vsk": "html"
      },
      "emmet.showExpandedAbbreviation": "always",
      "[vsk]": {
        "editor.defaultFormatter": "vesk.vesk-vscode"
      }
    },
    "grammars": [
      {
        "language": "vsk",
        "scopeName": "source.vsk",
        "path": "./syntaxes/vsk.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.tsx": "typescriptreact",
          "source.css": "css"
        }
      }
    ],
    "commands": [
      {
        "command": "vesk.restartLsp",
        "title": "Vesk: Restart Language Server"
      },
      {
        "command": "vesk.formatDocument",
        "title": "Vesk: Format Document"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.0"
  }
}
