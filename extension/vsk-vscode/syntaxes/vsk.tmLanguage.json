{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vesk",
  "scopeName": "source.vsk",
  "fileTypes": ["vsk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#component-declaration" },
    { "include": "#imports" },
    { "include": "#script-statements" },
    { "include": "#style-block" },
    { "include": "#head-block" },
    { "include": "#server-client-blocks" },
    { "include": "#reactive-declarations" },
    { "include": "#jsx-tags" },
    { "include": "#template-expressions" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tsx",
          "begin": "//",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.tsx" } }
        },
        {
          "name": "comment.block.tsx",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.tsx" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.tsx" } }
        }
      ]
    },
    "component-declaration": {
      "name": "meta.component.vsk",
      "begin": "(?:(export)\\s+)?(?:(default)\\s+)?\\b(component)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.export.tsx" },
        "2": { "name": "keyword.control.default.tsx" },
        "3": { "name": "storage.type.component.vsk" }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "name": "entity.name.function.tsx",
          "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\(|\\{|$)"
        },
        {
          "name": "meta.component.params.vsk",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.tsx" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.tsx" } },
          "patterns": [
            { "include": "#type-annotations" },
            { "include": "#strings" },
            { "include": "#comments" }
          ]
        },
        {
          "name": "storage.modifier.vsk",
          "match": "\\b(client|async)\\b"
        },
        {
          "name": "meta.component.body.vsk",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.tsx" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.tsx" } },
          "patterns": [
            { "include": "source.vsk" }
          ]
        }
      ]
    },
    "imports": {
      "name": "meta.import.tsx",
      "begin": "\\b(import)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.import.tsx" } },
      "end": "(?<=\\n|;)",
      "patterns": [
        { "include": "#strings" },
        { "include": "#comments" },
        { "match": "\\b(from)\\b", "name": "keyword.control.from.tsx" },
        { "match": "\\b(\\*)\\s+as\\s+([A-Za-z_$][\\w$]*)", "captures": { "2": { "name": "variable.other.readwrite.tsx" } } },
        { "match": "\\b([A-Za-z_$][\\w$]*)\\b", "name": "variable.other.readwrite.tsx" }
      ]
    },
    "script-statements": {
      "patterns": [
        {
          "match": "\\b(type|interface)\\s+([A-Za-z_$][\\w$]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.type.tsx" },
            "2": { "name": "entity.name.type.tsx" }
          }
        },
        {
          "match": "\\b(?:export\\s+)?(?:async\\s+)?function\\s*([A-Za-z_$][\\w$]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.tsx" } }
        },
        {
          "match": "\\b(?:export\\s+)?(?:abstract\\s+)?class\\s+([A-Za-z_$][\\w$]*)",
          "captures": { "1": { "name": "entity.name.type.class.tsx" } }
        },
        {
          "match": "\\b(?:export\\s+)?(?:default\\s+)?(?:const|let|var)\\s+([A-Za-z_$][\\w$]*)\\b",
          "captures": { "1": { "name": "variable.other.readwrite.tsx" } }
        }
      ]
    },
    "style-block": {
      "name": "meta.embedded.block.css.vsk",
      "begin": "<style>",
      "beginCaptures": { "0": { "name": "entity.name.tag.style.tsx" } },
      "end": "</style>",
      "endCaptures": { "0": { "name": "entity.name.tag.style.tsx" } },
      "contentName": "source.css",
      "patterns": [
        { "include": "source.css" }
      ]
    },
    "head-block": {
      "name": "meta.head.vsk",
      "begin": "(<)([Hh][Ee][Aa][Dd])(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.tsx" },
        "2": { "name": "entity.name.tag.tsx" },
        "3": { "name": "punctuation.definition.tag.end.tsx" }
      },
      "end": "(</)([Hh][Ee][Aa][Dd])(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.tsx" },
        "2": { "name": "entity.name.tag.tsx" },
        "3": { "name": "punctuation.definition.tag.end.tsx" }
      },
      "patterns": [
        { "include": "#jsx-tags" },
        { "include": "#template-expressions" },
        { "include": "#strings" }
      ]
    },
    "server-client-blocks": {
      "patterns": [
        {
          "name": "meta.block.server.vsk",
          "begin": "\\{#server\\}",
          "beginCaptures": { "0": { "name": "keyword.control.server-block.vsk" } },
          "end": "\\{\\/server\\}",
          "endCaptures": { "0": { "name": "keyword.control.server-block.vsk" } },
          "patterns": [{ "include": "source.vsk" }]
        },
        {
          "name": "meta.block.client.vsk",
          "begin": "\\{#client\\}",
          "beginCaptures": { "0": { "name": "keyword.control.client-block.vsk" } },
          "end": "\\{\\/client\\}",
          "endCaptures": { "0": { "name": "keyword.control.client-block.vsk" } },
          "patterns": [{ "include": "source.vsk" }]
        }
      ]
    },
    "jsx-tags": {
      "patterns": [
        { "include": "#jsx-tag-open" },
        { "include": "#jsx-tag-close" },
        { "include": "#jsx-tag-selfclose" },
        { "include": "#jsx-comments" }
      ]
    },
    "jsx-tag-open": {
      "name": "meta.tag.tsx",
      "begin": "(<)([A-Za-z_$][\\w$\\.\\-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.tsx" },
        "2": { "name": "entity.name.tag.tsx" }
      },
      "end": "(>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.end.tsx" } },
      "patterns": [
        { "include": "#jsx-attributes" },
        { "include": "#template-expressions" },
        { "include": "#strings" }
      ]
    },
    "jsx-tag-close": {
      "name": "meta.tag.tsx",
      "begin": "(</)([A-Za-z_$][\\w$\\.\\-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.tsx" },
        "2": { "name": "entity.name.tag.tsx" }
      },
      "end": "(>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.end.tsx" } }
    },
    "jsx-tag-selfclose": {
      "name": "meta.tag.tsx",
      "begin": "(<)([A-Za-z_$][\\w$\\.\\-]*)(?=\\s+[^>]*/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.tsx" },
        "2": { "name": "entity.name.tag.tsx" }
      },
      "end": "(/>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.end.tsx" } },
      "patterns": [
        { "include": "#jsx-attributes" },
        { "include": "#template-expressions" },
        { "include": "#strings" }
      ]
    },
    "jsx-comments": {
      "name": "comment.block.jsx.tsx",
      "begin": "\\{!--",
      "end": "--\\}"
    },
    "jsx-attributes": {
      "patterns": [
        {
          "match": "\\b(on[A-Z][a-zA-Z]*)\\s*=",
          "captures": { "1": { "name": "entity.other.attribute-name.event.tsx" } }
        },
        {
          "match": "\\b([a-zA-Z_$][\\w$]*)\\s*(?==)",
          "captures": { "1": { "name": "entity.other.attribute-name.tsx" } }
        },
        {
          "match": "\\b([a-zA-Z_$][\\w$]*)\\b(?![=(])",
          "captures": { "1": { "name": "entity.other.attribute-name.tsx" } }
        }
      ]
    },
    "template-expressions": {
      "name": "meta.embedded.block.tsx",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.tsx" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.tsx" } },
      "contentName": "source.tsx",
      "patterns": [
        { "include": "source.tsx" }
      ]
    },
    "reactive-declarations": {
      "name": "meta.reactive.vsk",
      "begin": "\\b(let|const)\\s*(&)",
      "beginCaptures": {
        "1": { "name": "storage.type.tsx" },
        "2": { "name": "keyword.operator.reactive.vsk" }
      },
      "end": "(?=\\n|;)",
      "patterns": [
        {
          "name": "variable.other.readwrite.reactive.vsk",
          "match": "\\b([a-zA-Z_$][\\w$]*)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tsx",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tsx" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tsx" } },
          "patterns": [
            { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.tsx" }
          ]
        },
        {
          "name": "string.quoted.single.tsx",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tsx" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tsx" } },
          "patterns": [
            { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.tsx" }
          ]
        },
        {
          "name": "string.quoted.template.tsx",
          "begin": "`",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tsx" } },
          "end": "`",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tsx" } },
          "patterns": [
            { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.tsx" },
            { "include": "#template-expressions" }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.tsx",
      "match": "\\b(\\d+\\.?\\d*|0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.tsx",
          "match": "\\b(new|typeof|instanceof|void|delete|in|of)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.tsx",
          "match": "[+\\-*/%]=?|\\b\\+\\+|--\\b"
        },
        {
          "name": "keyword.operator.comparison.tsx",
          "match": "===?|!==?|<=?|>=?|&&?|\\|\\|?"
        },
        {
          "name": "constant.language.tsx",
          "match": "\\b(this|super|arguments|null|undefined|true|false)\\b"
        },
        {
          "name": "keyword.control.tsx",
          "match": "\\b(if|else|for|while|do|switch|case|break|continue|return|try|catch|finally|throw|async|await)\\b"
        },
        {
          "name": "storage.type.tsx",
          "match": "\\b(let|const|var|function|class|import|export|default|from)\\b"
        },
        {
          "name": "support.type.primitive.tsx",
          "match": "\\b(string|number|boolean|any|void|never|unknown|null|undefined|object|symbol|bigint|bigint)\\b"
        }
      ]
    },
    "type-annotations": {
      "name": "meta.type.annotation.tsx",
      "begin": ":",
      "beginCaptures": { "0": { "name": "punctuation.definition.type.annotation.tsx" } },
      "end": "(?=[,\\)\\{\\}])",
      "patterns": [
        { "include": "#keywords" },
        { "include": "#strings" },
        { "match": "\\|", "name": "keyword.operator.type.tsx" },
        { "match": "&", "name": "keyword.operator.type.tsx" },
        { "match": "\\b[A-Z][\\w$]*\\b", "name": "entity.name.type.tsx" }
      ]
    }
  }
}
