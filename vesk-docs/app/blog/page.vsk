

component Blog {
	<Head>
		<title>blog — vesk</title>
		<meta name="description" content="News and notes from the Vesk project." />
	</Head>
	<div class="page-wrap page-wrap-wide">
		<div class="crumb">blog<span class="crumb-sep">/</span>index</div>
		<h1 class="page-h1">Blog</h1>
		<p class="page-lede">Notes from the project — what ships, what changed, and why.</p>
		<div class="demo-grid">
			<Link class="demo-card" href="/blog/hello-world">
				<div class="dc-meta"><span>2026 · post 001</span></div>
				<h2>Hello, world</h2>
				<p>The first post powered by Vesk — and why <code>.vsk</code> is a TypeScript superset.</p>
			</Link>
			<Link class="demo-card" href="/blog/ssr-in-vesk">
				<div class="dc-meta"><span>2026 · post 002</span></div>
				<h2>SSR in Vesk</h2>
				<p>How server-side rendering compiles a component to static HTML before a single byte reaches the client.</p>
			</Link>
		</div>
	</div>
}