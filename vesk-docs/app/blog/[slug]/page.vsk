

component BlogPost(props: { params: { slug: string } }) {
	<Head>
		<title>{props.params.slug} — vesk blog</title>
	</Head>
	<div class="page-wrap">
		<div class="crumb">
			<Link href="/blog">blog</Link><span class="crumb-sep">/</span>
			<span>{props.params.slug}</span>
		</div>
		<h1 class="page-h1">Post: {props.params.slug}</h1>
		<p class="page-lede">
			A dynamic route rendered at <code>/blog/{props.params.slug}</code> — served as SSR HTML,
			hydrated per cell, and updated via SPA navigation.
		</p>
		<div class="claims">
			<div class="claims-row">
				<div>
					<p class="claim-body">Voices from the file-based router: <code>app/blog/[slug]/page.vsk</code> becomes the route <code>/blog/:slug</code>, with the param decoded and passed in as a prop.</p>
				</div>
				<code class="claim-art">app/blog/[slug]/page.vsk → /blog/:slug</code>
			</div>
		</div>
	</div>
}