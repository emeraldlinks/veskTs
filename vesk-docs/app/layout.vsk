interface LayoutProps {
	children?: unknown
}

component Layout(props: LayoutProps) {
	<Head>
		<title>vesk — compiler-first framework for the post-VDOM web</title>
		<meta name="description" content="Vesk compiles .vsk to static server HTML and per-cell client updates. No virtual DOM, no hydration runtime for pages that don't move." />
		<link rel="icon" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Martian+Mono:wght@300;400;500;600;700&display=swap" />
	</Head>
	<a class="skip" href="#content">Skip to content</a>
	<header class="site-head">
		<NavLink href="/" class="brand">vesk<span class="brand-ext">.vsk</span></NavLink>
		<nav class="site-nav" aria-label="Primary">
			<NavLink href="/guide" activeClass="is-active" class="site-nav-link">guide</NavLink>
			<NavLink href="/blog" activeClass="is-active" class="site-nav-link">blog</NavLink>
			<NavLink href="/posts" activeClass="is-active" class="site-nav-link">data</NavLink>
			<NavLink href="/statements" activeClass="is-active" class="site-nav-link">statements</NavLink>
			<NavLink href="/about" activeClass="is-active" class="site-nav-link">about</NavLink>
		</nav>
		<span class="site-version">v0.2.8</span>
		<details class="menum">
			<summary>menu</summary>
			<nav class="menum-panel" aria-label="Mobile">
				<Link href="/guide">guide</Link>
				<Link href="/blog">blog</Link>
				<Link href="/posts">data</Link>
				<Link href="/statements">statements</Link>
				<Link href="/about">about</Link>
			</nav>
		</details>
	</header>
	<main id="content">{props.children}</main>
	<Footer />
}

component Footer {
	const path = usePathname()
	const file = path === '/' ? 'app/page.vsk' : `app${path}/page.vsk`
	<footer class="site-foot">
		<div class="foot-grid">
			<div>
				<Link class="foot-brand" href="/">vesk<span class="dot">.</span><span class="ext">vsk</span></Link>
				<p class="foot-tag">A compiler-first framework for the post-VDOM web. Server HTML and per-cell updates from one `.vsk` source.</p>
			</div>
			<div class="foot-col">
				<p class="foot-col-title">guide</p>
				<Link href="/guide">intro</Link>
				<Link href="/guide/language/statement-mode">statement mode</Link>
				<Link href="/guide/reactivity">reactivity</Link>
				<Link href="/guide/ssr-hydration">ssr + hydration</Link>
			</div>
			<div class="foot-col">
				<p class="foot-col-title">live demos</p>
				<Link href="/posts">data fetching</Link>
				<Link href="/statements">statement mode</Link>
				<Link href="/blog">blog</Link>
				<Link href="/about">about</Link>
			</div>
			<div class="foot-col">
				<p class="foot-col-title">project</p>
				<Link href="/about">about vesk</Link>
				<Link href="/blog">news</Link>
				<Link href="/guide/configuration">configuration</Link>
				<Link href="/guide/deployment">deployment</Link>
			</div>
		</div>
		<div class="ledger">
			<span class="live">●</span>
			<span>compiled</span>
			<span>·</span>
			<span>{file}</span>
			<span>·</span>
			<span>ssr: html ✓</span>
			<span>·</span>
			<span>hydrate: spa ✓</span>
			<span>·</span>
			<span>vdom: 0</span>
			<span class="ledger-r">MIT · © 2026 vesk · built with vesk</span>
		</div>
	</footer>
}