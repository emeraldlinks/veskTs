import { Md } from '@vesk/runtime';
import { track } from '@vesk/runtime';
import { firstHeading, tocFrom } from '../../_lib/guide';

component GuideDoc(props: { params: { path: string | string[] } }) {
	const segs = Array.isArray(props.params.path) ? props.params.path : [String(props.params.path)]
	const docPath = segs.join('/')
	const url = `/docs/guide/${docPath}/doc.md`
	const segLabel = segs[segs.length - 1]
	let &[src, srcCell] = track('')
	const res = useFetch.text(url, { into: srcCell, key: url })
	const toc = src ? tocFrom(src) : []
	const title = src ? firstHeading(src) : segLabel
	<Head>
		<title>{title} — vesk guide</title>
		<meta name="description" content={`Vesk documentation: ${title}`} />
	</Head>
	<div class="g-main">
		<div class="crumb">
			<a href="/guide">guide</a><span class="crumb-sep">/</span>
			<span>{docPath}</span><span class="crumb-sep">/</span>
			<span>doc.md</span>
		</div>
		<div class="doc-meta">
			<span class="m-the">source:</span>
			<span>public/docs/guide/{docPath}/doc.md</span>
			<span>·</span>
			<span>route: /guide/{docPath}</span>
		</div>
		if (res.loading && !src) {
			<div class="error-panel">
				<p class="ep-title">compiling</p>
				<p>Fetching doc.md from public/docs/guide/{docPath}/…</p>
			</div>
		}
		if (res.error && !src) {
			<div class="error-panel">
				<p class="ep-title">no source at this path</p>
				<p>We couldn't compile /guide/{docPath} — there's no doc.md under that route. <a href="/guide">Back to the guide index →</a></p>
			</div>
		}
		if (src) {
			<Md content={src} lineNumbers={true} />
		}
	</div>
	<aside class="g-toc">
		<p class="lbl">on this page</p>
		<ul class="toc-list">
			for (const h of toc) {
				<li class={h.level === 3 ? 'l2' : 'l1'}>
					<a href={`#${h.id}`}>{h.text}</a>
				</li>
			}
		</ul>
	</aside>
}