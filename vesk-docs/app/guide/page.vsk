import { Md } from '@vesk/runtime';
import { track } from '@vesk/runtime';

component GuideIndex {
	<Head>
		<title>guide — vesk documentation</title>
		<meta name="description" content="Complete documentation for Vesk: components, statement mode, reactivity, routing, server, and deployment." />
	</Head>
	<div class="g-main">
		<div class="crumb"><span class="m-the">./docs/guide</span><span class="crumb-sep">/</span>index.md</div>
		<div class="doc-meta">
			<span class="m-the">source:</span>
			<span>app/guide/page.vsk</span>
			<span>·</span>
			<span>route: /guide</span>
			<span>·</span>
			<span>static: true</span>
		</div>
		if (res.loading && !src) {
			<div class="error-panel">
				<p class="ep-title">compiling</p>
				<p>Fetching the guide index from public/docs/guide/index.md…</p>
			</div>
		}
		if (src) {
			<Md content="/docs/guide/index.md" lineNumbers={true} />
		}
	</div>
}