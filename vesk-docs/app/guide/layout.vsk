import { GUIDE } from '../lib/guide.ts';

export default component GuideLayout(props: { children?: unknown }) {
	<div class="g-mobile">
		<details class="g-sections">
			<summary>guide sections</summary>
			<SideNav />
		</details>
	</div>
	<div class="g-grid">
		<aside class="g-side">
			<SideNav />
		</aside>
		<div class="g-col">{props.children}</div>
	</div>
}

component SideNav {
	const path = usePathname()
	<nav class="g-nav" aria-label="Guide sections">
		<p class="lbl">guide index</p>
		<a class={path === '/guide' ? 'doc-link is-active' : 'doc-link'} href="/guide">
			<span class="p">index</span><span class="tick"></span><span class="lead">→</span>
		</a>
		for (const group of GUIDE) {
			<div class="g-group">
				<p class="g-group-title">{group.title}</p>
				for (const item of group.items) {
					<NavLink href={`/guide/${item.path}`} activeClass="is-active" class="doc-link">
						<span class="p">{item.path}</span><span class="tick"></span><span class="lead">→</span>
					</NavLink>
				}
			</div>
		}
	</nav>
}
